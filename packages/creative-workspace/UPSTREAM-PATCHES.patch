@@ -0,0 +1,233 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { Blob as NodeBlob } from 'node:buffer';
+import { buildTuziVideoRequest } from './tuzi-video-request';
+import { submitVideoGeneration } from './media-api/video-api';
+import {
+  fitGeminiOmniRequest,
+  GEMINI_OMNI_REQUEST_MAX_BYTES as LIMIT,
+} from './gemini-omni-request-budget';
+import { encodeTuziVideoBytes } from './tuzi-video-media';
+
+const settings = vi.hoisted(() => ({ keepOriginal: vi.fn(() => false) }));
+vi.mock('./reference-image-settings', () => ({
+  readKeepOriginalImageEnabled: settings.keepOriginal,
+}));
+const bytes = (size: number) => {
+  const value = new Uint8Array(size);
+  value.set([255, 216, 255, 224]);
+  return value;
+};
+const jpeg = (size: number) => encodeTuziVideoBytes(bytes(size), 'image/jpeg');
+const byteLength = (body: unknown) =>
+  new TextEncoder().encode(JSON.stringify(body)).length;
+const request = (references: string[], prompt = '让画面动起来') => ({
+  model: 'gemini-omni-1.2-flash',
+  prompt,
+  referenceImages: references,
+});
+let close: ReturnType<typeof vi.fn>;
+let draw: ReturnType<typeof vi.fn>;
+let encode: ReturnType<typeof vi.fn>;
+
+beforeEach(() => {
+  vi.stubGlobal('Blob', NodeBlob);
+  settings.keepOriginal.mockReturnValue(false);
+  close = vi.fn();
+  draw = vi.fn();
+  encode = vi.fn(
+    async ({ quality }: { quality: number }) =>
+      new Blob([bytes(Math.floor(quality * 400_000))], { type: 'image/jpeg' })
+  );
+  vi.stubGlobal(
+    'createImageBitmap',
+    vi.fn(async () => ({ width: 1600, height: 900, close }))
+  );
+  vi.stubGlobal(
+    'OffscreenCanvas',
+    class {
+      constructor(public width: number, public height: number) {}
+      getContext() {
+        return { fillRect: vi.fn(), drawImage: draw };
+      }
+      convertToBlob = encode;
+    }
+  );
+});
+afterEach(() => {
+  vi.unstubAllGlobals();
+  vi.restoreAllMocks();
+});
+
+describe('Gemini Omni serialized request budget', () => {
+  it('compresses an image below 1 MiB whose Base64 exceeds the request limit', async () => {
+    const source = jpeg(900_000);
+    const body = await buildTuziVideoRequest(request([source]));
+    expect(byteLength(body)).toBeLessThan(LIMIT);
+    expect(body).toMatchObject({
+      input: [
+        { type: 'text', text: '让画面动起来' },
+        { type: 'image', mime_type: 'image/jpeg' },
+      ],
+    });
+    expect(source).toBe(jpeg(900_000));
+    expect(draw).toHaveBeenCalledWith(expect.anything(), 0, 0, 1600, 900);
+    expect(close).toHaveBeenCalledOnce();
+  });
+
+  it('budgets multiple images together, preserving input order and small images', async () => {
+    const small = jpeg(100);
+    const body = await buildTuziVideoRequest(
+      request([jpeg(600_000), small, jpeg(600_000)])
+    );
+    expect(byteLength(body)).toBeLessThan(LIMIT);
+    const parts = body!.input as Array<Record<string, unknown>>;
+    expect(parts).toHaveLength(4);
+    expect(parts[2].data).toBe(small.split(',')[1]);
+    expect(close).toHaveBeenCalledTimes(2);
+  });
+
+  it('counts UTF-8 text and request metadata, not just image bytes', async () => {
+    const body = await buildTuziVideoRequest(
+      request([jpeg(600_000)], '湖'.repeat(150_000))
+    );
+    expect(byteLength(body)).toBeLessThan(LIMIT);
+    expect(encode).toHaveBeenCalled();
+  });
+
+  it('keeps small inline images and public image URLs unchanged', async () => {
+    const local = jpeg(100);
+    const body = await buildTuziVideoRequest(request([local]));
+    expect((body!.input as Array<Record<string, unknown>>)[1].data).toBe(
+      local.split(',')[1]
+    );
+    expect(
+      await buildTuziVideoRequest(request(['https://example.test/a.png']))
+    ).toMatchObject({
+      prompt: '让画面动起来',
+      input_reference: 'https://example.test/a.png',
+    });
+    expect(encode).not.toHaveBeenCalled();
+  });
+
+  it('applies the same limit to cached canvas references and explicit image parts', async () => {
+    const source = jpeg(900_000);
+    const resolve = vi.fn(async () => source);
+    const cached = await buildTuziVideoRequest(
+      request(['/__aitu_cache__/image/source.png']),
+      resolve
+    );
+    const explicit = await buildTuziVideoRequest({
+      ...request([], ''),
+      params: {
+        input: [
+          {
+            type: 'image',
+            mime_type: 'image/jpeg',
+            data: source.split(',')[1],
+          },
+        ],
+      },
+    });
+    expect(resolve).toHaveBeenCalledWith('/__aitu_cache__/image/source.png');
+    expect(byteLength(cached)).toBeLessThan(LIMIT);
+    expect(byteLength(explicit)).toBeLessThan(LIMIT);
+    expect(close).toHaveBeenCalledTimes(2);
+  });
+
+  it('accepts exactly the byte limit and rejects oversized text without dropping it', async () => {
+    const base = { prompt: '' };
+    const exact = { prompt: 'a'.repeat(LIMIT - byteLength(base)) };
+    expect(await fitGeminiOmniRequest(exact)).toBe(exact);
+    await expect(
+      fitGeminiOmniRequest({ prompt: exact.prompt + 'a' })
+    ).rejects.toThrow('1 MiB');
+  });
+
+  it('refuses oversized videos or text instead of deleting input', async () => {
+    await expect(
+      buildTuziVideoRequest({
+        ...request([]),
+        params: {
+          video_media: [
+            {
+              type: 'video',
+              url: `data:video/mp4;base64,${'AAAA'.repeat(300_000)}`,
+            },
+          ],
+        },
+      })
+    ).rejects.toThrow('1 MiB');
+    await expect(
+      buildTuziVideoRequest(request([jpeg(20)], '湖'.repeat(400_000)))
+    ).rejects.toThrow('1 MiB');
+    expect(encode).not.toHaveBeenCalled();
+  });
+
+  it('respects keep-original and fails before submitting any request', async () => {
+    settings.keepOriginal.mockReturnValue(true);
+    const fetchImpl = vi.fn();
+    await expect(
+      submitVideoGeneration(request([jpeg(900_000)]), {
+        baseUrl: 'https://example.test/v1',
+        apiKey: 'test',
+        fetchImpl,
+      })
+    ).rejects.toThrow('保留原图');
+    expect(fetchImpl).not.toHaveBeenCalled();
+    expect(encode).not.toHaveBeenCalled();
+  });
+
+  it('submits exactly once and puts the bounded JSON on the wire', async () => {
+    const fetchImpl = vi.fn(async (_url: unknown, init?: RequestInit) => {
+      expect(new TextEncoder().encode(String(init?.body)).length).toBeLessThan(
+        LIMIT
+      );
+      return new Response(JSON.stringify({ id: 'task_small' }));
+    });
+    expect(
+      await submitVideoGeneration(request([jpeg(900_000)]), {
+        baseUrl: 'https://example.test/v1',
+        apiKey: 'test',
+        fetchImpl,
+      })
+    ).toBe('task_small');
+    expect(fetchImpl).toHaveBeenCalledOnce();
+  });
+
+  it('rejects compression failure and releases decoded images', async () => {
+    encode.mockRejectedValue(new Error('encode failed'));
+    await expect(
+      buildTuziVideoRequest(request([jpeg(900_000)]))
+    ).rejects.toThrow('encode failed');
+    expect(close).toHaveBeenCalledOnce();
+  });
+
+  it('rejects a still-oversized output without mutating the original request', async () => {
+    encode.mockResolvedValue(
+      new Blob([bytes(900_000)], { type: 'image/jpeg' })
+    );
+    const body = {
+      input: [
+        {
+          type: 'image',
+          mime_type: 'image/jpeg',
+          data: jpeg(900_000).split(',')[1],
+        },
+      ],
+    };
+    const before = JSON.stringify(body);
+    await expect(fitGeminiOmniRequest(body)).rejects.toThrow('1 MiB');
+    expect(JSON.stringify(body)).toBe(before);
+    expect(close).toHaveBeenCalledOnce();
+  });
+
+  it('does not impose this limit on other video models', async () => {
+    const source = jpeg(900_000);
+    const body = await buildTuziVideoRequest({
+      ...request([source]),
+      model: 'wan3.0-video',
+    });
+    expect(byteLength(body)).toBeGreaterThan(LIMIT);
+    expect(encode).not.toHaveBeenCalled();
+  });
+});
diff --git a/packages/drawnix/src/services/gemini-omni-request-budget.ts b/packages/drawnix/src/services/gemini-omni-request-budget.ts
new file mode 100644
index 0000000..8cf30fa
--- /dev/null
+++ b/packages/drawnix/src/services/gemini-omni-request-budget.ts
@@ -0,0 +1,136 @@
+import { readKeepOriginalImageEnabled } from './reference-image-settings';
+import { encodeTuziVideoBlob, parseVideoMediaData } from './tuzi-video-media';
+
+// This channel limits the serialized request, not the decoded image file.
+export const GEMINI_OMNI_REQUEST_MAX_BYTES = 1024 * 1024;
+const REQUEST_HEADROOM_BYTES = 16 * 1024;
+const budgetError = () =>
+  new Error(
+    'Gemini Omni 视频请求超过 1 MiB 限制，请减少参考素材、缩短提示词，或使用供应商可访问的图片/视频 URL'
+  );
+const jsonBytes = (value: unknown) =>
+  new TextEncoder().encode(JSON.stringify(value)).byteLength;
+
+async function compressReference(blob: Blob, maxBytes: number): Promise<Blob> {
+  let source: CanvasImageSource;
+  let width: number;
+  let height: number;
+  let cleanup: () => void;
+  if (typeof createImageBitmap === 'function') {
+    const bitmap = await createImageBitmap(blob);
+    source = bitmap;
+    width = bitmap.width;
+    height = bitmap.height;
+    cleanup = () => bitmap.close();
+  } else {
+    const url = URL.createObjectURL(blob);
+    const image = new Image();
+    try {
+      await new Promise<void>((resolve, reject) => {
+        image.onload = () => resolve();
+        image.onerror = () => reject(new Error('参考图片解码失败'));
+        image.src = url;
+      });
+    } catch (error) {
+      URL.revokeObjectURL(url);
+      throw error;
+    }
+    source = image;
+    width = image.naturalWidth;
+    height = image.naturalHeight;
+    cleanup = () => URL.revokeObjectURL(url);
+  }
+  try {
+    // Re-encode only the submission copy. Keep aspect ratio and never crop.
+    for (let round = 0; round < 10; round++) {
+      const scale = Math.pow(0.8, round);
+      const w = Math.max(1, Math.round(width * scale));
+      const h = Math.max(1, Math.round(height * scale));
+      if (round > 0 && Math.max(w, h) < 256) break;
+      const canvas =
+        typeof OffscreenCanvas !== 'undefined'
+          ? new OffscreenCanvas(w, h)
+          : Object.assign(document.createElement('canvas'), {
+              width: w,
+              height: h,
+            });
+      const ctx = canvas.getContext('2d') as
+        | CanvasRenderingContext2D
+        | OffscreenCanvasRenderingContext2D
+        | null;
+      if (!ctx) throw new Error('当前环境无法压缩参考图片');
+      ctx.fillStyle = '#ffffff';
+      ctx.fillRect(0, 0, w, h);
+      ctx.drawImage(source, 0, 0, w, h);
+      for (const quality of [0.9, 0.75, 0.6]) {
+        const output =
+          'convertToBlob' in canvas
+            ? await canvas.convertToBlob({ type: 'image/jpeg', quality })
+            : await new Promise<Blob>((resolve, reject) =>
+                canvas.toBlob(
+                  (value) =>
+                    value
+                      ? resolve(value)
+                      : reject(new Error('参考图片压缩失败')),
+                  'image/jpeg',
+                  quality
+                )
+              );
+        if (output.size <= maxBytes) return output;
+      }
+    }
+    throw budgetError();
+  } finally {
+    cleanup();
+  }
+}
+
+/** Enforce the aggregate UTF-8 JSON budget after all references are resolved. */
+export async function fitGeminiOmniRequest(
+  body: Record<string, unknown>
+): Promise<Record<string, unknown>> {
+  if (jsonBytes(body) <= GEMINI_OMNI_REQUEST_MAX_BYTES) return body;
+  const input = Array.isArray(body.input)
+    ? body.input.map((part: Record<string, unknown>) => ({ ...part }))
+    : [];
+  const images = input.filter(
+    (part) => part.type === 'image' && typeof part.data === 'string'
+  );
+  if (!images.length) throw budgetError();
+  if (readKeepOriginalImageEnabled()) {
+    throw new Error(
+      'Gemini Omni 视频请求超过 1 MiB；请关闭“保留原图”以压缩提交副本，或使用供应商可访问的参考图 URL'
+    );
+  }
+  const result = { ...body, input };
+  // Text, URLs, videos and all other fields consume the same request budget.
+  const imageData = images.map((part) => ({ part, data: String(part.data) }));
+  images.forEach((part) => {
+    part.data = '';
+  });
+  let remaining =
+    GEMINI_OMNI_REQUEST_MAX_BYTES - REQUEST_HEADROOM_BYTES - jsonBytes(result);
+  if (remaining <= 0) throw budgetError();
+  imageData.sort((a, b) => a.data.length - b.data.length);
+  for (const [index, { part, data }] of imageData.entries()) {
+    const allowance =
+      Math.floor(remaining / (imageData.length - index) / 4) * 4;
+    if (data.length <= allowance) {
+      part.data = data;
+    } else {
+      if (allowance < 4) throw budgetError();
+      const parsed = parseVideoMediaData(data, String(part.mime_type));
+      const output = await compressReference(
+        new Blob([parsed.bytes], { type: parsed.mime }),
+        (allowance / 4) * 3
+      );
+      const encoded = await encodeTuziVideoBlob(output);
+      const compressed = parseVideoMediaData(encoded);
+      part.data = compressed.data;
+      part.mime_type = compressed.mime;
+    }
+    remaining -= String(part.data).length;
+  }
+  if (jsonBytes(result) > GEMINI_OMNI_REQUEST_MAX_BYTES) throw budgetError();
+  return result;
+}
diff --git a/packages/drawnix/src/services/gemini-omni-video.ts b/packages/drawnix/src/services/gemini-omni-video.ts
new file mode 100644
index 0000000..2afd37b
--- /dev/null
+++ b/packages/drawnix/src/services/gemini-omni-video.ts
@@ -0,0 +1,48 @@
+import { compressImageBlob } from '@aitu/utils';
+import { getGeminiOmniVideoMetadata, GEMINI_OMNI_MODEL_ID, GEMINI_OMNI_SIZES, isGeminiOmniModel } from '../utils/gemini-omni-model';
+import { readKeepOriginalImageEnabled } from './reference-image-settings';
+
+/** Our gateway accepts JSON; the Mux interaction transport stays on the server. */
+export async function buildGeminiOmniVideoBody(form: FormData, signal?: AbortSignal): Promise<string> {
+  const model = String(form.get('model') || GEMINI_OMNI_MODEL_ID).trim();
+  if (!isGeminiOmniModel(model)) throw new Error('Gemini Omni 视频模型无效');
+  const prompt = String(form.get('prompt') || '').trim();
+  const metadata = getGeminiOmniVideoMetadata(model);
+  const seconds = String(form.get('seconds') || metadata.defaultDuration);
+  const size = String(form.get('size') || '1280x720');
+  if (!prompt) throw new Error('请填写视频提示词');
+  if (!metadata.allowedDurations?.includes(seconds)) throw new Error('Gemini Omni 视频时长须为 3–15 秒整数');
+  if (!GEMINI_OMNI_SIZES.some(option => option.value === size))
+    throw new Error('Gemini Omni 请选择 360P、720P、1080P 或 4K 的横屏/竖屏尺寸');
+  const references = form.getAll('input_reference');
+  if (references.length > 10) throw new Error('Gemini Omni 最多支持 10 张参考图');
+  // Explicit allowlist: never forward Veo/Sora watermark or arbitrary old params.
+  const body: Record<string, unknown> = { model, seconds, size };
+  if (!references.length) body.prompt = prompt;
+  else {
+    const input: Record<string, string>[] = [{ type: 'text', text: prompt }];
+    // Leave room for JSON and text in the gateway's 1 MiB runtime snapshot.
+    const maxBytes = Math.floor(640 * 1024 / references.length);
+    for (const reference of references) {
+      signal?.throwIfAborted();
+      if (!(reference instanceof Blob) || !reference.type.startsWith('image/') || !reference.size)
+        throw new Error('Gemini Omni 参考图无效，请重新上传图片');
+      let blob: Blob = reference;
+      if (blob.size > maxBytes && !readKeepOriginalImageEnabled())
+        blob = await compressImageBlob(blob, maxBytes / 1024 ** 2);
+      if (blob.size > maxBytes)
+        throw new Error('Gemini Omni 参考图总量过大，请压缩、减少图片或关闭保留原图后重试');
+      const bytes = new Uint8Array(await blob.arrayBuffer());
+      let binary = '';
+      for (let i = 0; i < bytes.length; i += 8192)
+        binary += String.fromCharCode(...bytes.subarray(i, i + 8192));
+      input.push({ type: 'image', mime_type: blob.type, data: btoa(binary) });
+    }
+    body.input = input;
+  }
+  signal?.throwIfAborted();
+  const json = JSON.stringify(body);
+  if (new TextEncoder().encode(json).length > 960 * 1024)
+    throw new Error('Gemini Omni 请求过大，请缩短提示词或减少参考图');
+  return json;
+}
