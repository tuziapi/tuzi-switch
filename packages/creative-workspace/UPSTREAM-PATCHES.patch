+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { bindGenerationThumbnail } from './generation-node-thumbnail';
+import { unifiedCacheService } from './unified-cache-service';
+vi.mock('@aitu/utils', () => ({ normalizeImageDataUrl: (url: string) => url }));
+vi.mock('./unified-cache-service', () => ({
+  unifiedCacheService: { getCachedBlob: vi.fn() },
+}));
+const flush = async () => {
+  await vi.dynamicImportSettled();
+};
+afterEach(() => {
+  vi.unstubAllGlobals();
+  vi.restoreAllMocks();
+});
+describe('generation thumbnail cache', () => {
+  it('uses cached image bytes and revokes their URL when removed', async () => {
+    const create = vi.fn(() => 'blob:thumbnail');
+    const revoke = vi.fn();
+    vi.stubGlobal('URL', { createObjectURL: create, revokeObjectURL: revoke });
+    vi.mocked(unifiedCacheService.getCachedBlob).mockResolvedValue(
+      new Blob(['image'])
+    );
+    const image = document.createElementNS(
+      'http://www.w3.org/2000/svg',
+      'image'
+    );
+    const cleanup = bindGenerationThumbnail(image, '/cached.png');
+    image.dispatchEvent(new Event('error'));
+    await flush();
+    expect(image.getAttribute('href')).toBe('blob:thumbnail');
+    image.dispatchEvent(new Event('load'));
+    expect(image.hasAttribute('visibility')).toBe(false);
+    expect(unifiedCacheService.getCachedBlob).toHaveBeenCalledWith(
+      '/cached.png',
+      { allowNetwork: false }
+    );
+    cleanup();
+    expect(revoke).toHaveBeenCalledWith('blob:thumbnail');
+  });
+  it('does not create an object URL after a thumbnail has been removed', async () => {
+    const create = vi.fn();
+    vi.stubGlobal('URL', { createObjectURL: create, revokeObjectURL: vi.fn() });
+    vi.mocked(unifiedCacheService.getCachedBlob).mockResolvedValue(
+      new Blob(['image'])
+    );
+    const image = document.createElementNS(
+      'http://www.w3.org/2000/svg',
+      'image'
+    );
+    bindGenerationThumbnail(image, '/cached.png')();
+    await flush();
+    expect(create).not.toHaveBeenCalled();
+  });
+});
diff --git a/packages/drawnix/src/services/generation-node-thumbnail.ts b/packages/drawnix/src/services/generation-node-thumbnail.ts
new file mode 100644
index 0000000..67ad226
--- /dev/null
+++ b/packages/drawnix/src/services/generation-node-thumbnail.ts
@@ -0,0 +1,45 @@
+import { isVirtualMediaUrl } from '../utils/virtual-media-url';
+
+/** SVG thumbnails need the same local-cache fallback as the canvas image renderer. */
+export function bindGenerationThumbnail(
+  image: Element,
+  originalUrl: string
+): () => void {
+  let url = originalUrl;
+  let disposed = false;
+  let objectUrl: string | undefined;
+  const fallback = () => {
+    if (!disposed) image.setAttribute('visibility', 'hidden');
+  };
+  const loaded = () => {
+    if (!disposed) image.removeAttribute('visibility');
+  };
+  image.addEventListener('error', fallback);
+  image.addEventListener('load', loaded);
+  const load = async () => {
+    try {
+      const { normalizeImageDataUrl } = await import('@aitu/utils');
+      if (disposed) return;
+      url = normalizeImageDataUrl(originalUrl);
+      if (!url.startsWith('data:') && !url.startsWith('blob:')) {
+        const { unifiedCacheService } = await import('./unified-cache-service');
+        const blob = await unifiedCacheService.getCachedBlob(url, {
+          allowNetwork: false,
+        });
+        if (disposed) return;
+        if (blob) objectUrl = URL.createObjectURL(blob);
+      }
+      if (!disposed) image.setAttribute('href', objectUrl || url);
+    } catch {
+      if (!disposed) image.setAttribute('href', url);
+    }
+  };
+  if (!isVirtualMediaUrl(url)) image.setAttribute('href', url);
+  void load();
+  return () => {
+    disposed = true;
+    image.removeEventListener('error', fallback);
+    image.removeEventListener('load', loaded);
+    if (objectUrl) URL.revokeObjectURL(objectUrl);
+  };
+}
diff --git a/packages/drawnix/src/services/generation-node.test.ts b/packages/drawnix/src/services/generation-node.test.ts
new file mode 100644
index 0000000..9b7ac9c
--- /dev/null
+++ b/packages/drawnix/src/services/generation-node.test.ts
@@ -0,0 +1,106 @@
+import { describe, expect, it } from 'vitest';
+import {
+  appendGenerationReference,
+  GenerationNodeData,
+  remapGenerationNode,
+  snapshotGenerationReferences,
+  validateGenerationNode,
+} from './generation-node';
+const a = { id: 'a', type: 'image', url: '/a.png' };
+const b = { id: 'b', type: 'image', url: '/a.png' };
+const empty = (): GenerationNodeData => ({
+  version: 1,
+  generationType: 'image',
+  prompt: 'hello',
+  params: { quality: 'high' },
+  count: 2,
+  references: [],
+});
+describe('generation node draft', () => {
+  it('keeps distinct sources with the same pixels, but repeated connections are idempotent', () => {
+    const one = appendGenerationReference(empty(), a);
+    expect(appendGenerationReference(one, a)).toBe(one);
+    const two = appendGenerationReference(one, b);
+    expect(two.references.map((ref) => ref.sourceElementId)).toEqual([
+      'a',
+      'b',
+    ]);
+    expect(new Set(two.references.map((ref) => ref.referenceId)).size).toBe(2);
+  });
+  it('remaps copied sources and detaches uncopied live ids without losing media or order', () => {
+    const data = appendGenerationReference(
+      appendGenerationReference(empty(), a),
+      b
+    );
+    const copy = remapGenerationNode(data, new Map([['a', 'copy-a']]));
+    expect(copy.references.map((ref) => ref.sourceElementId)).toEqual([
+      'copy-a',
+      undefined,
+    ]);
+    expect(copy.references.map((ref) => ref.url)).toEqual(['/a.png', '/a.png']);
+    expect(copy.references[0].referenceId).not.toBe(
+      data.references[0].referenceId
+    );
+    expect(copy.params).toEqual(data.params);
+    expect(data.references[0].sourceElementId).toBe('a');
+  });
+  it('source deletion blocks new submission while an earlier snapshot stays unchanged', () => {
+    const data = appendGenerationReference(empty(), a);
+    const frozen = snapshotGenerationReferences(data, [a]);
+    expect(validateGenerationNode(data, [])).toEqual([
+      '参考图来源已删除，请移除或重新连接',
+    ]);
+    expect(
+      snapshotGenerationReferences(data, [{ ...a, url: '/changed.png' }])[0].url
+    ).toBe('/changed.png');
+    expect(frozen[0].url).toBe('/a.png');
+  });
+  it('rejects excessive video references and requires explicit frame roles', () => {
+    const data = {
+      ...appendGenerationReference(appendGenerationReference(empty(), a), b),
+      generationType: 'video' as const,
+    };
+    expect(
+      validateGenerationNode(data, [a, b], { mode: 'reference', maxCount: 1 })
+    ).toHaveLength(1);
+    expect(
+      validateGenerationNode(data, [a, b], { mode: 'frames', maxCount: 2 })
+    ).toHaveLength(1);
+    data.references[0].role = 'last-frame';
+    data.references[1].role = 'first-frame';
+    expect(
+      validateGenerationNode(data, [a, b], { mode: 'frames', maxCount: 2 })
+    ).toEqual([]);
+    expect(
+      snapshotGenerationReferences(data, [a, b]).map(
+        (ref) => ref.sourceElementId
+      )
+    ).toEqual(['b', 'a']);
+    expect(data.references.map((ref) => ref.sourceElementId)).toEqual([
+      'a',
+      'b',
+    ]);
+    expect(
+      validateGenerationNode(data, [a, b], { mode: 'reference', maxCount: 3 })
+    ).toHaveLength(1);
+  });
+  it('rejects a lone last frame and duplicate first frames', () => {
+    const data = {
+      ...appendGenerationReference(empty(), a),
+      generationType: 'video' as const,
+    };
+    data.references[0].role = 'last-frame';
+    expect(
+      validateGenerationNode(data, [a], { mode: 'frames', maxCount: 2 })
+    ).toContain('请先添加首帧');
+    data.references.push({
+      ...data.references[0],
+      referenceId: 'second',
+      role: 'first-frame',
+    });
+    data.references[0].role = 'first-frame';
+    expect(
+      validateGenerationNode(data, [a], { mode: 'frames', maxCount: 2 })
+    ).toContain('首帧和尾帧各只能设置一张');
+  });
+});
diff --git a/packages/drawnix/src/services/generation-node.ts b/packages/drawnix/src/services/generation-node.ts
new file mode 100644
index 0000000..5fca62d
--- /dev/null
+++ b/packages/drawnix/src/services/generation-node.ts
@@ -0,0 +1,253 @@
+import {
+  addSelectedElement,
+  clearSelectedElement,
+  idCreator,
+  PlaitBoard,
+  PlaitElement,
+  Point,
+  Transforms,
+} from '@plait/core';
+import { BasicShapes, createDefaultGeometry } from '@plait/draw';
+import type { AIInputPrefillImage } from './ai-input-ui-events';
+import type { ModelRef } from '../utils/settings-manager';
+import type { ImageUploadConfig } from '../types/video.types';
+
+export const GENERATION_NODE_CHANGE = 'aitu:generation-node-change';
+export function notifyGenerationNodeChange(board: PlaitBoard, openNodeId?: string) {
+  window.dispatchEvent(new CustomEvent(GENERATION_NODE_CHANGE, { detail: { board, openNodeId } }));
+}
+/** Choose facing sides, so a card to the left never sends a wire through its source. */
+export function generationConnectionSides(source: { x: number; width: number }, target: { x: number; width: number }) {
+  const targetIsRight = target.x + target.width / 2 >= source.x + source.width / 2;
+  return { sourceX: targetIsRight ? 1 : 0, targetX: targetIsRight ? 0 : 1 };
+}
+
+/** Separate, stable input ports; keep the header and footer free of wires. */
+export function generationInputPort(
+  index: number,
+  count: number,
+  height: number
+): Point {
+  const inset = Math.min(56, height / 4);
+  return [
+    0,
+    (inset + ((height - inset * 2) * (index + 1)) / (count + 1)) / height,
+  ];
+}
+export type GenerationReferenceRole =
+  | 'reference'
+  | 'first-frame'
+  | 'last-frame';
+export interface GenerationNodeReference extends AIInputPrefillImage {
+  referenceId: string;
+  role: GenerationReferenceRole;
+}
+export interface GenerationNodeData {
+  version: 1;
+  generationType: 'image' | 'video';
+  prompt: string;
+  model?: string;
+  modelRef?: ModelRef | null;
+  params: Record<string, string>;
+  count: number;
+  references: GenerationNodeReference[];
+}
+export type GenerationNodeElement = PlaitElement & {
+  generationNode: GenerationNodeData;
+  points: Point[];
+};
+export function isGenerationNode(
+  element: PlaitElement | null | undefined
+): element is GenerationNodeElement {
+  const data = element?.generationNode;
+  return (
+    !!data &&
+    data.version === 1 &&
+    (data.generationType === 'image' || data.generationType === 'video') &&
+    typeof data.prompt === 'string' &&
+    data.params &&
+    typeof data.params === 'object' &&
+    Number.isInteger(data.count) &&
+    data.count > 0 &&
+    Array.isArray(data.references) &&
+    data.references.every(
+      (ref: GenerationNodeReference) =>
+        ref &&
+        typeof ref.referenceId === 'string' &&
+        typeof ref.url === 'string' &&
+        ['reference', 'first-frame', 'last-frame'].includes(ref.role)
+    )
+  );
+}
+export function isGenerationSource(element: PlaitElement | undefined): boolean {
+  return (
+    element?.type === 'image' &&
+    !element.isVideo &&
+    !element.isAudio &&
+    typeof element.url === 'string'
+  );
+}
+export function createGenerationReference(
+  source: PlaitElement
+): GenerationNodeReference {
+  return {
+    referenceId: idCreator(),
+    role: 'reference',
+    sourceElementId: source.id,
+    sourceElementUrl: source.url,
+    url: source.url,
+    name: source.name || '参考图',
+  };
+}
+export function appendGenerationReference(
+  data: GenerationNodeData,
+  source: PlaitElement
+): GenerationNodeData {
+  if (
+    !isGenerationSource(source) ||
+    data.references.some((ref) => ref.sourceElementId === source.id)
+  )
+    return data;
+  return {
+    ...data,
+    references: [...data.references, createGenerationReference(source)],
+  };
+}
+export function updateGenerationNode(
+  board: PlaitBoard,
+  id: string,
+  data: GenerationNodeData
+): void {
+  const index = board.children.findIndex((element) => element.id === id);
+  if (index < 0 || !isGenerationNode(board.children[index])) return;
+  if (
+    JSON.stringify(board.children[index].generationNode) ===
+    JSON.stringify(data)
+  )
+    return;
+  Transforms.setNode(board, { generationNode: structuredClone(data) }, [index]);
+}
+export function addGenerationReference(
+  board: PlaitBoard,
+  node: GenerationNodeElement,
+  source: PlaitElement
+): void {
+  updateGenerationNode(
+    board,
+    node.id,
+    appendGenerationReference(node.generationNode, source)
+  );
+}
+export function createGenerationNode(
+  board: PlaitBoard,
+  point: Point,
+  type: 'image' | 'video',
+  source: PlaitElement
+): GenerationNodeElement {
+  const shape = createDefaultGeometry(
+    board,
+    [point, [point[0] + 344, point[1] + 224]],
+    BasicShapes.roundRectangle
+  );
+  const node = {
+    ...shape,
+    fill: '#ffffff',
+    strokeColor: '#dcdbe5',
+    strokeWidth: 1,
+    generationNode: {
+      version: 1 as const,
+      generationType: type,
+      prompt: '',
+      params: {},
+      count: 1,
+      references: [createGenerationReference(source)],
+    },
+  };
+  Transforms.insertNode(board, node, [board.children.length]);
+  clearSelectedElement(board);
+  addSelectedElement(board, node);
+  return node;
+}
+
+/** A copied draft carries media; only sources included in the copy remain live. */
+export function remapGenerationNode(
+  data: GenerationNodeData,
+  ids: Map<string, string>
+): GenerationNodeData {
+  return {
+    ...structuredClone(data),
+    references: data.references.map((ref) => ({
+      ...ref,
+      referenceId: idCreator(),
+      sourceElementId: ref.sourceElementId
+        ? ids.get(ref.sourceElementId)
+        : undefined,
+    })),
+  };
+}
+
+export function validateGenerationNode(
+  data: GenerationNodeData,
+  elements: readonly PlaitElement[],
+  video?: ImageUploadConfig
+): string[] {
+  const errors: string[] = [];
+  if (
+    data.references.some(
+      (ref) =>
+        ref.sourceElementId &&
+        !elements.some(
+          (el) => el.id === ref.sourceElementId && isGenerationSource(el)
+        )
+    )
+  )
+    errors.push('参考图来源已删除，请移除或重新连接');
+  if (data.generationType === 'image') {
+    if (data.references.some((ref) => ref.role !== 'reference'))
+      errors.push('图片生成仅支持普通参考图，请调整引用角色');
+  } else if (video) {
+    if (data.references.length > video.maxCount)
+      errors.push(`当前视频模型最多支持 ${video.maxCount} 张图片，请调整引用`);
+    if (video.required && !data.references.length)
+      errors.push('当前视频模型需要参考图');
+    if (video.mode === 'frames') {
+      if (data.references.some((ref) => ref.role === 'reference'))
+        errors.push('当前视频模型需要明确首帧/尾帧，请设置引用角色');
+      if (
+        data.references.filter((ref) => ref.role === 'first-frame').length >
+          1 ||
+        data.references.filter((ref) => ref.role === 'last-frame').length > 1
+      )
+        errors.push('首帧和尾帧各只能设置一张');
+      if (
+        data.references.some((ref) => ref.role === 'last-frame') &&
+        !data.references.some((ref) => ref.role === 'first-frame')
+      )
+        errors.push('请先添加首帧');
+    } else if (data.references.some((ref) => ref.role !== 'reference'))
+      errors.push('当前视频模型使用普通参考图，请调整引用角色');
+  }
+  return errors;
+}
+
+export function snapshotGenerationReferences(
+  data: GenerationNodeData,
+  elements: readonly PlaitElement[]
+): GenerationNodeReference[] {
+  const refs = data.references.map((ref) => {
+    const source =
+      ref.sourceElementId &&
+      elements.find((el) => el.id === ref.sourceElementId);
+    return source
+      ? { ...ref, url: source.url, sourceElementUrl: source.url }
+      : { ...ref };
+  });
+  // Frame adapters consume [first, last]. Roles stay explicit in the draft.
+  return data.generationType === 'video' &&
+    refs.some((ref) => ref.role !== 'reference')
+    ? refs.sort(
+        (a, b) =>
+          Number(a.role === 'last-frame') - Number(b.role === 'last-frame')
+      )
+    : refs;
+}
diff --git a/packages/drawnix/src/services/image-generation-recipe.test.ts b/packages/drawnix/src/services/image-generation-recipe.test.ts
new file mode 100644
index 0000000..50c0ae5
--- /dev/null
+++ b/packages/drawnix/src/services/image-generation-recipe.test.ts
@@ -0,0 +1,147 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { TaskStatus, TaskType, type Task } from '../types/task.types';
+import {
+  prepareImageGenerationRecipe,
+  getPreparedImageRecipe,
+  readImageGenerationRecipe,
+  resolveRecipeCanvasSources,
+  validateRestoredImageReferences,
+} from './image-generation-recipe';
+import {
+  collectEmbeddedMediaFromElements,
+  restoreEmbeddedMedia,
+} from '../data/embedded-media';
+
+const cache = vi.hoisted(() => new Map<string, Blob>());
+vi.mock('./canvas-operations/image-generation-references', () => ({
+  imageKey: (url: string) => url,
+}));
+vi.mock('./media-executor/fallback-utils', () => ({
+  cacheRemoteUrl: vi.fn(async (url: string, id: string) => {
+    if (url.startsWith('/__aitu_cache__/')) return url;
+    const target = `/__aitu_cache__/image/${id}.png`;
+    cache.set(target, new Blob([url], { type: 'image/png' }));
+    return target;
+  }),
+}));
+vi.mock('./unified-cache-service', () => ({
+  unifiedCacheService: {
+    getCachedBlob: vi.fn(async (url: string) => cache.get(url)),
+    getCacheInfo: vi.fn(async () => ({ cachedAt: 1, lastUsed: 1 })),
+    isCached: vi.fn(async (url: string) => cache.has(url)),
+    cacheMediaFromBlob: vi.fn(async (url: string, blob: Blob) => {
+      cache.set(url, blob);
+      return url;
+    }),
+  },
+}));
+vi.mock('../data/image', () => ({
+  loadImageElementForCanvas: vi.fn(async (url: string) => {
+    if (!cache.has(url)) throw new Error('missing bytes');
+    return { width: 10, height: 10 };
+  }),
+}));
+
+function task(): Task {
+  return {
+    id: 'original',
+    type: TaskType.IMAGE,
+    status: TaskStatus.COMPLETED,
+    createdAt: 1,
+    updatedAt: 1,
+    params: {
+      prompt: '原提示词',
+      model: 'gpt-image-2',
+      referenceImages: ['https://image.test/a.png'],
+      maskImage: 'https://image.test/mask.png',
+    },
+  };
+}
+
+describe('generation recipes stored with canvas results', () => {
+  beforeEach(() => cache.clear());
+
+  it('restores references and masks from a canvas backup after task history and local media are gone', async () => {
+    const original = task();
+    await prepareImageGenerationRecipe(original);
+    const element = {
+      id: 'result',
+      type: 'image',
+      url: 'https://image.test/result.png',
+      imageGenerationRecipe: getPreparedImageRecipe(original),
+    };
+    const saved = JSON.parse(JSON.stringify([element]));
+    const embedded = await collectEmbeddedMediaFromElements(saved);
+    expect(embedded).toHaveLength(2);
+    expect(JSON.stringify(saved)).not.toContain('data:image');
+    cache.clear();
+    const input = readImageGenerationRecipe(saved[0])!;
+    await expect(
+      validateRestoredImageReferences(input.images!)
+    ).rejects.toThrow('原参考图 1');
+    await restoreEmbeddedMedia(embedded);
+    await expect(
+      validateRestoredImageReferences(input.images!)
+    ).resolves.toBeUndefined();
+    expect(input.prompt).toBe('原提示词');
+    expect(input.images).toHaveLength(1);
