+++ b/packages/drawnix/src/components/text-chat/DiscussionResults.tsx
@@ -0,0 +1,382 @@
+import React, { useEffect, useState } from "react";
+import { LocateFixed, RotateCcw } from "lucide-react";
+import type { DiscussionLink } from "../../services/text-chat/conversation";
+import { taskQueueService } from "../../services/task-queue";
+import { TaskStatus } from "../../types/task.types";
+import { workspaceService } from "../../services/workspace-service";
+import { useDrawnix } from "../../hooks/use-drawnix";
+import { WorkflowResultImage } from "../chat-drawer/WorkflowResultImage";
+import { useMediaUrl } from "../../hooks/useMediaCache";
+import { textChatRuntime } from "../../services/text-chat/runtime";
+import { discussionTargetLabels } from "../../services/text-chat/discussion-plan";
+import { TextMarkdown, copyChatText } from "./TextMarkdown";
+import { isVideoElement } from "../../plugins/with-video";
+import { scrollToPoint } from "../../utils/selection-utils";
+
+function DiscussionMedia({
+  taskId,
+  source,
+  audio,
+}: {
+  taskId: string;
+  source: string;
+  audio?: boolean;
+}) {
+  const { url, isLoading } = useMediaUrl(taskId, source);
+  if (audio)
+    return url ? (
+      <audio src={url} controls preload="none" aria-label="生成音频" />
+    ) : (
+      <span>
+        {isLoading ? "正在读取音频…" : "音频缓存不可用，请在任务列表查看。"}
+      </span>
+    );
+  return url ? (
+    <video src={url} controls preload="none" aria-label="生成视频" />
+  ) : (
+    <span>
+      {isLoading ? "正在读取视频…" : "视频缓存不可用，请在任务列表查看。"}
+    </span>
+  );
+}
+
+export function DiscussionResults({
+  link,
+  onLocate,
+  sessionId,
+  messageId,
+  busy,
+}: {
+  link: DiscussionLink;
+  onLocate?: () => void;
+  sessionId?: string;
+  messageId?: string;
+  busy?: boolean;
+}) {
+  const read = () =>
+    taskQueueService
+      .getAllTasks()
+      .filter(
+        (t) =>
+          t.params.conversationLink?.runId === link.runId &&
+          t.params.conversationLink?.boardId === link.boardId,
+      );
+  const [tasks, setTasks] = useState(read);
+  const [notice, setNotice] = useState("");
+  const { board } = useDrawnix();
+  useEffect(() => {
+    setTasks(read());
+    const sub = taskQueueService.observeTaskUpdates().subscribe(({ task }) => {
+      if (task.params.conversationLink?.runId === link.runId) setTasks(read());
+    });
+    return () => sub.unsubscribe();
+  }, [link.runId]);
+  const action = (taskId: string, locate: boolean) => {
+    if (workspaceService.getState().currentBoardId !== link.boardId) {
+      setNotice("请先返回这段讨论所属的画板，再定位或同步结果。");
+      return;
+    }
+    if (!locate) {
+      window.dispatchEvent(
+        new CustomEvent("aitu:discussion-sync", { detail: { taskId } }),
+      );
+      setNotice("正在同步已有结果，不会重新生成。");
+      return;
+    }
+    const task = tasks.find((t) => t.id === taskId);
+    const urls = task?.result?.urls || [task?.result?.url];
+    const element = board?.children.find(
+      (e) => e.generationTaskId === taskId || urls.includes(e.url as string),
+    );
+    if (element?.points?.[0]) {
+      onLocate?.();
+      requestAnimationFrame(() => {
+        if (workspaceService.getState().currentBoardId === link.boardId)
+          scrollToPoint(board!, element.points[0]);
+      });
+    } else setNotice("画布中未找到该作品，可能已被删除。聊天记录仍保留。");
+  };
+  const decide = async (execute: boolean) => {
+    if (!sessionId || !messageId) return;
+    if (
+      execute &&
+      workspaceService.getState().currentBoardId !== link.boardId
+    ) {
+      setNotice("请先返回这段讨论所属的画板再执行。");
+      return;
+    }
+    try {
+      await textChatRuntime.decidePlan(sessionId, messageId, execute);
+    } catch (e) {
+      setNotice((e as Error).message);
+    }
+  };
+  const decideCanvas = async (execute: boolean) => {
+    if (!sessionId || !messageId) return;
+    try {
+      await textChatRuntime.decideCanvasPlan(sessionId, messageId, execute);
+    } catch (error) {
+      setNotice((error as Error).message);
+    }
+  };
+  const targetLabel = (id: string) => {
+    if (!board || workspaceService.getState().currentBoardId !== link.boardId)
+      return id;
+    const index = board.children.findIndex((element) => element.id === id);
+    if (index < 0) return `${id}（已不在画布）`;
+    const element = board.children[index];
+    const kind = isVideoElement(element)
+      ? "视频"
+      : element.type === "image"
+        ? "图片"
+        : element.text
+          ? "文字"
+          : "元素";
+    const name = String(
+      element.name ||
+        element.title ||
+        element.generationPrompt ||
+        element.text?.children?.[0]?.text ||
+        "",
+    ).slice(0, 50);
+    return `画布第 ${index + 1} 项 · ${kind}${name ? `「${name}」` : ""}`;
+  };
+  const actionLabels = {
+    locate: "定位",
+    move: "移动",
+    arrange: "排列",
+    scale: "缩放",
+    copy: "复制",
+    set_text: "编辑文字",
+    delete: "删除",
+    replace: "替换媒体",
+  };
+  if (!tasks.length && !link.plan && !link.canvasPlan) return null;
+  return (
+    <section
+      className="discussion-results"
+      aria-label="讨论生成任务"
+      onMouseDown={(event) => {
+        // Blurring the attached composer changes its height between down/up in WebKit.
+        // Preserve that focus until the click is delivered; keyboard activation is unchanged.
+        if (
+          event.button === 0 &&
+          (event.target as Element).closest("button") &&
+          document.activeElement?.matches('[data-testid="ai-input-textarea"]')
+        )
+          event.preventDefault();
+      }}
+    >
+      {link.canvasPlan && (
+        <div className="discussion-plan" data-testid="canvas-edit-plan">
+          <strong>
+            {
+              {
+                ready: "待确认的画布操作",
+                started: "正在执行画布操作",
+                applied: "画布操作已完成，可撤销恢复",
+                cancelled: "画布操作已取消",
+                error: "画布操作未完成，请查看提示后重新发送",
+              }[link.canvasPlan.status]
+            }
+          </strong>
+          <ol>
+            {link.canvasPlan.actions.map((action, index) => (
+              <li key={index}>
+                <strong>
+                  {actionLabels[action.op]} · {action.ids.length} 个元素
+                </strong>
+                <small title={action.ids.join("、")}>
+                  目标：{action.ids.map(targetLabel).join("、")}
+                </small>
+                {action.op === "set_text" && <p>{action.text}</p>}
+                {(action.op === "move" || action.op === "copy") && (
+                  <p>
+                    横向 {action.dx}，纵向 {action.dy}
+                  </p>
+                )}
+                {action.op === "scale" && <p>缩放至 {action.scale} 倍</p>}
+                {action.op === "arrange" && (
+                  <p>
+                    {action.columns} 列，间距 {action.gap}
+                  </p>
+                )}
+                {action.op === "replace" && (
+                  <p>使用元素：{targetLabel(action.sourceId!)}</p>
+                )}
+              </li>
+            ))}
+          </ol>
+          {link.canvasPlan.status === "ready" && (
+            <div className="discussion-plan__actions">
+              <button
+                type="button"
+                disabled={busy}
+                onClick={() => void decideCanvas(false)}
+              >
+                取消操作
+              </button>
+              <button
+                type="button"
+                disabled={busy}
+                onClick={() => void decideCanvas(true)}
+              >
+                确认修改画布
+              </button>
+            </div>
+          )}
+        </div>
+      )}
+      {link.plan && (
+        <div className="discussion-plan" data-testid="discussion-plan">
+          <div className="discussion-plan__heading">
+            <strong>
+              {link.plan.status === "ready"
+                ? "待确认的生成计划"
+                : link.plan.status === "cancelled"
+                  ? "计划已取消"
+                  : "已提交的生成计划"}
+            </strong>
+            <span>
+              {link.plan.steps.reduce((n, s) => n + s.count, 0)} 个任务
+            </span>
+          </div>
+          <ol>
+            {link.plan.steps.map((step, i) => (
+              <li key={i}>
+                <div>
+                  <strong>
+                    {discussionTargetLabels[step.type]} {i + 1}
+                    {step.count > 1 ? ` · 同一提示词 × ${step.count}` : ""}
+                  </strong>
+                  <small title={step.model}>{step.model}</small>
+                </div>
+                <p>{step.prompt}</p>
+              </li>
+            ))}
+          </ol>
+          {link.plan.status === "ready" && (
+            <>
+              <small>
+                {link.plan.steps.some((step) => step.type === "image")
+                  ? "每条图片提示词描述一张作品；同一提示词的多张变体分别生成。"
+                  : "使用计划中的模型执行。"}
+                调整底部模型后，请重新讨论生成计划。
+              </small>
+              <div className="discussion-plan__actions">
+                <button
+                  type="button"
+                  disabled={busy}
+                  onClick={() => void decide(false)}
+                >
+                  取消计划
+                </button>
+                <button
+                  type="button"
+                  className="discussion-plan__execute"
+                  disabled={busy}
+                  onClick={() => void decide(true)}
+                >
+                  执行 {link.plan.steps.reduce((n, s) => n + s.count, 0)} 个任务
+                </button>
+              </div>
+            </>
+          )}
+        </div>
+      )}
+      {tasks.length > 0 && (
+        <div className="text-chat-status">
+          生成任务 ·{" "}
+          {tasks.filter((t) => t.status === TaskStatus.COMPLETED).length}/
+          {tasks.length} 完成
+        </div>
+      )}
+      {tasks.map((task) => (
+        <div className="discussion-result" key={task.id} data-task-id={task.id}>
+          <div className="discussion-result-media">
+            {(task.result?.urls?.length
+              ? task.result.urls
+              : task.result?.url
+                ? [task.result.url]
+                : []
+            ).map((url, i) =>
+              task.type === "video" || task.type === "audio" ? (
+                <DiscussionMedia
+                  key={url}
+                  taskId={task.id}
+                  source={url}
+                  audio={task.type === "audio"}
+                />
+              ) : (
+                <WorkflowResultImage
+                  key={url}
+                  url={url}
+                  thumbnailUrl={task.result?.thumbnailUrls?.[i]}
+                  index={i}
+                  onPreview={() => action(task.id, true)}
+                />
+              ),
+            )}
+          </div>
+          {(task.result?.chatResponse || task.result?.lyricsText) && (
+            <div className="discussion-result-text">
+              <TextMarkdown
+                content={
+                  task.result.chatResponse || task.result.lyricsText || ""
+                }
+              />
+              <button
+                type="button"
+                onClick={() =>
+                  void copyChatText(
+                    task.result?.chatResponse || task.result?.lyricsText || "",
+                  )
+                    .then(() => setNotice("已复制文本"))
+                    .catch((e) => setNotice(e.message))
+                }
+              >
+                复制文本
+              </button>
+            </div>
+          )}
+          <small>
+            {task.params.model} ·{" "}
+            {task.status === TaskStatus.COMPLETED
+              ? task.insertedToCanvas
+                ? "已放入画布"
+                : task.type === "chat"
+                  ? "已生成 · 保留在讨论中"
+                  : "已生成 · 等待画布同步"
+              : task.status === TaskStatus.FAILED
+                ? "生成失败，请在任务列表查看详情"
+                : task.status === TaskStatus.CANCELLED
+                  ? "已停止"
+                  : "生成中"}
+          </small>
+          {task.status === TaskStatus.COMPLETED && (
+            <button
+              type="button"
+              onClick={() => action(task.id, Boolean(task.insertedToCanvas))}
+            >
+              {task.insertedToCanvas ? (
+                <LocateFixed size={13} />
+              ) : (
+                <RotateCcw size={13} />
+              )}
+              {task.insertedToCanvas
+                ? "定位画布"
+                : task.type === "chat"
+                  ? "放入画布"
+                  : "同步到画布"}
+            </button>
+          )}
+        </div>
+      ))}
+      {notice && (
+        <div className="text-chat-status" role="status">
+          {notice}
+        </div>
+      )}
+    </section>
+  );
+}
diff --git a/packages/drawnix/src/components/text-chat/TextAttachments.tsx b/packages/drawnix/src/components/text-chat/TextAttachments.tsx
new file mode 100644
index 0000000..9c7e372
--- /dev/null
+++ b/packages/drawnix/src/components/text-chat/TextAttachments.tsx
@@ -0,0 +1,174 @@
+import { memo, useEffect, useRef, useState } from "react";
+import { createPortal } from "react-dom";
+import { FileText, Image as ImageIcon, X } from "lucide-react";
+import {
+  readTextAttachment,
+  type TextAttachmentRef,
+  type TextAttachmentRecord,
+} from "../../services/text-chat/attachments";
+
+const AttachmentCard = memo(function AttachmentCard({
+  attachment,
+  remove,
+}: {
+  attachment: TextAttachmentRef;
+  remove?: (id: string) => void;
+}) {
+  const [record, setRecord] = useState<TextAttachmentRecord | null>(null);
+  const [error, setError] = useState("");
+  const [open, setOpen] = useState(false);
+  const preview = useRef<HTMLDivElement>(null);
+  const trigger = useRef<HTMLButtonElement>(null);
+  useEffect(() => {
+    if (attachment.kind !== "image" && !open) return;
+    let active = true;
+    void readTextAttachment(attachment)
+      .then((r) => {
+        if (active)
+          setRecord(
+            !open && r.thumbnailDataUrl ? { ...r, dataUrl: undefined } : r,
+          );
+      })
+      .catch((e) => {
+        if (active) setError(e.message);
+      });
+    return () => {
+      active = false;
+    };
+  }, [attachment.id, attachment.kind, open]);
+  useEffect(() => {
+    if (open) preview.current?.focus();
+  }, [open]);
+  const close = () => {
+    setOpen(false);
+    trigger.current?.focus();
+  };
+  return (
+    <>
+      <div className="text-chat-attachment" data-attachment-id={attachment.id}>
+        <button
+          ref={trigger}
+          type="button"
+          className="text-chat-attachment-open"
+          aria-label={`预览附件 ${attachment.name}`}
+          onClick={() => setOpen(true)}
+        >
+          {attachment.kind === "image" ? (
+            record?.thumbnailDataUrl || record?.dataUrl ? (
+              <img
+                src={record.thumbnailDataUrl || record.dataUrl}
+                alt=""
+                loading="lazy"
+              />
+            ) : (
+              <ImageIcon />
+            )
+          ) : (
+            <FileText />
+          )}
+          <span>
+            <strong>{attachment.name}</strong>
+            <small>
+              {attachment.kind === "image"
+                ? "图片"
+                : attachment.pages
+                  ? `PDF · ${attachment.pages} 页 · 提取文字`
+                  : "文本文件"}{" "}
+              · {Math.max(1, Math.round(attachment.size / 1024))} KB
+            </small>
+          </span>
+        </button>
+        {remove && (
+          <button
+            type="button"
+            className="text-chat-attachment-remove"
+            aria-label={`移除附件 ${attachment.name}`}
+            onClick={() => remove(attachment.id)}
+          >
+            <X size={14} />
+          </button>
+        )}
+        {(error || attachment.warning) && (
+          <span className="text-chat-attachment-warning" role="status">
+            {error || attachment.warning}
+          </span>
+        )}
+      </div>
+      {open &&
+        createPortal(
+          <div
+            className="text-chat-attachment-backdrop"
+            onPointerDown={(e) => {
+              e.stopPropagation();
+              if (e.target === e.currentTarget) close();
+            }}
+            onWheel={(e) => e.stopPropagation()}
+          >
+            <div
+              ref={preview}
+              tabIndex={-1}
+              role="dialog"
+              aria-modal="true"
+              aria-label={`附件预览 ${attachment.name}`}
+              className="text-chat-attachment-preview"
+              onKeyDownCapture={(e) => {
+                e.stopPropagation();
+                if (e.key === "Escape") {
+                  e.preventDefault();
+                  close();
+                }
+                if (e.key === "Tab") {
+                  e.preventDefault();
+                  preview.current
+                    ?.querySelector<HTMLButtonElement>("button")
+                    ?.focus();
+                }
+              }}
+            >
+              <header>
+                <strong>{attachment.name}</strong>
+                <button type="button" aria-label="关闭附件预览" onClick={close}>
+                  <X />
+                </button>
+              </header>
+              {error ? (
+                <p role="alert">{error}</p>
+              ) : !record ? (
+                <p>正在读取附件…</p>
+              ) : attachment.kind === "image" ? (
+                <img src={record.dataUrl} alt={attachment.name} />
+              ) : (
+                <>
+                  <small>
+                    发送给模型的提取文字
+                    {attachment.pages
+                      ? "（不包含 PDF 图片、图表及原始版式）"
+                      : ""}
+                  </small>
+                  <pre>{record.text}</pre>
+                </>
+              )}
+              {attachment.warning && <p>{attachment.warning}</p>}
+            </div>
+          </div>,
+          trigger.current?.closest(".creative-root") || document.body,
+        )}
+    </>
+  );
+});
+export function TextAttachments({
+  attachments,
+  onRemove,
+}: {
+  attachments?: TextAttachmentRef[];
+  onRemove?: (id: string) => void;
+}) {
+  if (!attachments?.length) return null;
+  return (
+    <div className="text-chat-attachments">
+      {attachments.map((a) => (
+        <AttachmentCard key={a.id} attachment={a} remove={onRemove} />
+      ))}
+    </div>
+  );
+}
diff --git a/packages/drawnix/src/components/text-chat/TextChatWorkspace.tsx b/packages/drawnix/src/components/text-chat/TextChatWorkspace.tsx
new file mode 100644
index 0000000..eb640b1
--- /dev/null
+++ b/packages/drawnix/src/components/text-chat/TextChatWorkspace.tsx
@@ -0,0 +1,1279 @@
+import { resolveBuiltinAssetUrl } from "../../utils/bundled-assets";
+import React, {
+  memo,
+  useCallback,
+  useEffect,
+  useMemo,
+  useLayoutEffect,
+  useRef,
+  useState,
+  useSyncExternalStore,
+} from "react";
+import {
+  ArrowUp,
+  Check,
+  ChevronDown,
+  Copy,
+  ListChecks,
+  Loader2,
+  MessageCircle,
+  PanelLeftClose,
+  PanelLeftOpen,
+  PencilLine,
+  Plus,
+  Rabbit,
+  RotateCcw,
+  ScanText,
+  Search,
+  SlidersHorizontal,
+  Square,
+  Trash2,
+  X,
+  Code2,
+  Feather,
+  Lightbulb,
+  Paperclip,
+  Maximize2,
+  Minimize2,
+} from "lucide-react";
+import { useVirtualizer } from "@tanstack/react-virtual";
+import type { TextConversation } from "../../services/text-chat/conversation";
+import { ModelSelector } from "../chat-drawer/ModelSelector";
+import { ConfirmDialog } from "../dialog/ConfirmDialog";
+import { useDrawnix } from "../../hooks/use-drawnix";
+import { chatStorageService } from "../../services/chat-storage-service";
+import { textChatRuntime as runtime } from "../../services/text-chat/runtime";
+import {
+  newTextState,
+  canRetryDiscussion,
+  type TextMessage,
+} from "../../services/text-chat/conversation";
+import {
+  settingsManager,
+  resolveInvocationRoute,
+  createModelRef,
+  type ModelRef,
+} from "../../utils/settings-manager";
+import { quickInsert } from "../../services/canvas-operations/canvas-insertion";
+import { TextMarkdown, copyChatText } from "./TextMarkdown";
+import { TextAttachments } from "./TextAttachments";
+import {
+  ATTACHMENT_ACCEPT,
+  ATTACHMENT_LIMITS,
+  attachmentFileKind,
+  saveTextAttachment,
+  removeTextAttachment,
+} from "../../services/text-chat/attachments";
+import { DiscussionResults } from "./DiscussionResults";
+import { DiscussionBackend } from "./DiscussionBackend";
+import { openDiscussion } from "../../services/text-chat/discussion-ui";
+import { workspaceService } from "../../services/workspace-service";
+import "./text-chat.scss";
+
+const completedReasons = new Set(["stop", "end_turn", "STOP", "stop_sequence"]);
+const MessageView = memo(function MessageView({
+  message,
+  retryPrompt,
+  retryBlocked,
+  busy,
+  onRetry,
+  onInsert,
+  onLocate,
+  sessionId,
+}: {
+  sessionId?: string;
+  message: TextMessage;
+  retryPrompt?: string;
+  retryBlocked?: boolean;
+  busy: boolean;
+  onRetry: (userId: string) => void;
+  onInsert: (text: string) => void;
+  onLocate?: () => void;
+}) {
+  const [copied, setCopied] = useState(false);
+  const [copyError, setCopyError] = useState("");
+  const copying = async () => {
+    try {
+      await copyChatText(message.content);
+      setCopied(true);
+      setCopyError("");
+    } catch (e) {
+      setCopyError((e as Error).message);
+    }
+  };
+  if (message.role === "user")
+    return (
+      <div className="text-chat-user" data-message-id={message.id}>
+        {message.origin === "canvas" && <small className="text-chat-status">来自画布主输入框</small>}
+        <TextAttachments attachments={message.attachments} />
+        {message.content}
+        {message.canvasContext && <small className="text-chat-canvas-context">{message.canvasContext.notice}</small>}
+      </div>
+    );
+  const generating = ["pending", "streaming"].includes(message.status);
+  return (
+    <article
+      className="text-chat-answer"
+      data-message-id={message.id}
+      data-status={message.status}
+    >
+      <div className="text-chat-author">
+        <img className="text-chat-avatar" src={resolveBuiltinAssetUrl("/logo-tuzi.png")} alt="" width={28} height={28} />
+        <strong>兔子助手</strong>
+        {message.model && <small className="text-chat-author-model">{message.model}</small>}
+        {generating && (
+          <span>
+            <Loader2 size={13} className="text-chat-spin" />
+            {message.reasoning && !message.content
+              ? "正在思考"
+              : message.content
+                ? "正在回复"
+                : "等待回复"}
+          </span>
+        )}
+      </div>
+      {retryPrompt && (
+        <div className="text-chat-status">重新回复：{retryPrompt}</div>
+      )}
+      {message.reasoning && (
+        <details className="text-chat-reasoning">
+          <summary>
+            模型思考摘要 <ChevronDown size={12} />
+          </summary>
+          <div>
+            <TextMarkdown content={message.reasoning} />
+          </div>
+        </details>
+      )}
+      {message.content && <TextMarkdown content={message.content} />}
+      {message.discussion && <DiscussionResults link={message.discussion} sessionId={sessionId} messageId={message.id} busy={busy} onLocate={onLocate} />}
+      {message.status === "stopped" && (
+        <div className="text-chat-status">已停止 · 已保留收到的内容</div>
+      )}
+      {message.error && (
+        <div className="text-chat-error" role="status">
+          {message.error}
+        </div>
+      )}
+      {message.status === "complete" &&
+        message.finishReason &&
+        !completedReasons.has(message.finishReason) && (
+          <div className="text-chat-status">
+            本次回复结束：
+            {[
+              "length",
+              "max_tokens",
+              "max_output_tokens",
+              "MAX_TOKENS",
+            ].includes(message.finishReason)
+              ? "达到输出长度上限"
+              : message.finishReason}
+          </div>
+        )}
+      {!generating && (
+        <div className="text-chat-message-actions">
+          <button type="button" onClick={copying} disabled={!message.content}>
+            {copied ? <Check /> : <Copy />}
+            {copied ? "已复制" : "复制"}
+          </button>
+          <button
+            type="button"
+            disabled={busy || retryBlocked || !message.replyTo || Boolean(message.discussion && !canRetryDiscussion(message))}
+            onClick={() => message.replyTo && onRetry(message.replyTo)}
+          >
+            <RotateCcw />
+            {message.status === "error" || message.status === "interrupted"
+              ? "重试"
+              : "重新生成"}
+          </button>
+          <button
+            type="button"
+            disabled={!message.content}
+            onClick={() => onInsert(message.content)}
+          >
+            <PanelLeftClose />
+            插入画布
+          </button>
+          {message.usage?.output !== undefined && (
+            <span>{message.usage.output.toLocaleString()} 输出 tokens</span>
+          )}
+        </div>
+      )}
+      {copyError && (
+        <div role="status" className="text-chat-error">
+          {copyError}
+        </div>
+      )}
+    </article>
+  );
+});
+
+const SessionRow = memo(function SessionRow({
+  s,
+  active,
+  running,
+  onSelect,
+  onRename,
+  onDelete,
