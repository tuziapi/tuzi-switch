+      expect(model.videoDefaults?.size).toBe(config.defaultSize);
+      expect(
+        params
+          .find((param) => param.id === 'duration')
+          ?.options?.map((option) => option.value)
+      ).toEqual([...config.durationOptions.map((option) => option.value), ...(id === 'wan3.0-video' ? ['-1'] : [])]);
+      expect(
+        params
