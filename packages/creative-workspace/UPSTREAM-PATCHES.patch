+          ),
+      ];
+    }),
+  ) as Record<DiscussionTarget, ModelRef>;
+  const models = Object.fromEntries(
+    kinds.map((kind) => [kind, refs[kind]?.modelId || ""]),
+  ) as Record<DiscussionTarget, string>;
+  const prompt = request.turns.at(-1)?.content || "";
+  const selection = {
+    ...(context?.selection || {
