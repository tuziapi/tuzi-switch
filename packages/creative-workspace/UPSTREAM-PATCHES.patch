+  &__heading { font-size: 13px; span { opacity: .65; } }
+  ol { max-height: 210px; overflow-y: auto; padding-left: 22px; margin: 10px 0; overscroll-behavior: contain; }
+  li { padding: 6px 2px; font-size: 12px; }
+  li small { max-width: 55%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; opacity: .65; }
+  p { margin: 5px 0; white-space: pre-wrap; overflow-wrap: anywhere; }
+  > small { font-size: 11px; opacity: .65; }
+  &__actions { justify-content: flex-end; margin-top: 10px; button { padding: 6px 12px; border-radius: 8px; border: 1px solid rgba(128,128,128,.22); background: transparent; color: inherit; cursor: pointer; } }
+  button.discussion-plan__execute { background: #6457cf; color: #fff; border-color: transparent; }
+  button:disabled { opacity: .5; cursor: default; }
+}
+.discussion-result-text { max-height: 240px; overflow: auto; width: 100%; }
+.discussion-result-media audio { max-width: 100%; height: 34px; }
+.discussion-routing > .discussion-backend { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; flex: 1 1 100%; }
+.discussion-backend {
+  &__row { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; max-width: 100%; }
+  button, select { color: inherit; font: inherit; font-size: 12px; background: var(--text-chat-bg, transparent); border: 1px solid rgba(128,128,128,.22); border-radius: 7px; padding: 5px 8px; }
+  button { display: inline-flex; align-items: center; gap: 5px; cursor: pointer; }
+  select { max-width: 230px; min-width: 0; text-overflow: ellipsis; }
+  button:disabled, select:disabled { opacity: .5; cursor: default; }
+  > small { font-size: 10px; opacity: .65; }
+  &__error { font-size: 11px; color: var(--text-chat-error, #b34b45); overflow-wrap: anywhere; button { margin-left: 7px; } }
+}
+
+.text-chat-avatar { width: 28px; height: 28px; flex: 0 0 28px; object-fit: contain; border-radius: 9px; padding: 3px; background: #fff; border: 1px solid var(--tc-line); box-sizing: border-box; }
+.text-chat-author-model { font-size: 11px; color: var(--tc-soft); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
+.text-chat-author > strong { flex-shrink: 0; }
