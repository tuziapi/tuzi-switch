diff --git a/packages/drawnix/src/components/settings-dialog/assistant-account-binding.scss b/packages/drawnix/src/components/settings-dialog/assistant-account-binding.scss
new file mode 100644
index 0000000..11e43e2
--- /dev/null
+++ b/packages/drawnix/src/components/settings-dialog/assistant-account-binding.scss
@@ -0,0 +1,244 @@
+.assistant-account-binding {
+  margin: 0 0 22px;
+  padding: 16px;
+  border: 1px solid var(--td-component-border, #e7e4df);
+  border-radius: 14px;
+  background: var(--td-bg-color-container, #fff);
+  color: var(--td-text-color-primary, #25241f);
+  p {
+    margin: 10px 0 0;
+    font-size: 12px;
+    color: var(--td-text-color-secondary, #777);
+    line-height: 1.6;
+  }
+  button {
+    border: 0;
+    background: transparent;
+    color: inherit;
+    font: inherit;
+    cursor: pointer;
+    border-radius: 8px;
+    padding: 8px 10px;
+  }
+  button:disabled {
+    opacity: 0.45;
+    cursor: not-allowed;
+  }
+  &__modes {
+    display: flex;
+    gap: 6px;
+    padding: 4px;
+    background: var(--td-bg-color-secondarycontainer, #f5f3ef);
+    border-radius: 10px;
+    button {
+      display: flex;
+      gap: 7px;
+      align-items: center;
+      justify-content: center;
+      flex: 1;
+      font-size: 13px;
+    }
+    button[aria-pressed="true"] {
+      background: var(--td-bg-color-container, #fff);
+      box-shadow: 0 1px 4px #0000000d;
+      font-weight: 600;
+    }
+  }
+  &__status {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 12px;
+    margin: 12px 0;
+    font-size: 12px;
+    flex-wrap: wrap;
+    button {
+      color: var(--td-brand-color, #a36627);
+    }
+  }
+  &__selected,
+  &__key {
+    width: 100%;
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    text-align: left;
+    gap: 12px;
+    span:first-child {
+      min-width: 0;
+    }
+    strong,
+    small {
+      display: block;
+      overflow-wrap: anywhere;
+    }
+    strong {
+      font-size: 13px;
+      font-weight: 500;
+    }
+    small {
+      font-size: 12px;
+      opacity: 0.65;
+      margin-top: 3px;
+    }
+  }
+  &__selected {
+    border: 1px solid var(--td-component-border, #e7e4df) !important;
+    padding: 12px !important;
+  }
+  &__picker {
+    margin-top: 10px;
+    input {
+      width: 100%;
+      box-sizing: border-box;
+      border: 1px solid var(--td-component-border, #e7e4df);
+      background: transparent;
+      color: inherit;
+      border-radius: 8px;
+      padding: 9px;
+      font: inherit;
+    }
+  }
+  &__key:hover:not(:disabled) {
+    background: var(--td-bg-color-secondarycontainer, #f5f3ef);
+  }
+  &__pages {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    font-size: 12px;
+    margin-top: 8px;
+  }
+  [role="alert"] {
+    color: var(--td-error-color, #c43c39);
+  }
+}
+.settings-dialog--assistant {
+  .settings-dialog__layout {
+    display: flex;
+    flex-direction: column;
+  }
+  .settings-dialog__nav {
+    width: 100%;
+    flex: none;
+    border-right: 0;
+    border-bottom: 1px solid var(--td-component-border, #e7e4df);
+    padding: 8px 16px;
+  }
+  .settings-dialog__nav-shell {
+    padding: 0;
+  }
+  .settings-dialog__nav-list {
+    display: flex;
+    flex-direction: row;
+    gap: 6px;
+    flex-wrap: wrap;
+  }
+  .settings-dialog__nav-item {
+    width: auto;
+    padding: 8px 14px;
+    border-radius: 9px;
+  }
+  .settings-dialog__main {
+    flex: 1;
+    min-height: 0;
+    overflow: hidden;
+  }
+  .settings-dialog__content-panel {
+    padding: 22px;
+  }
+  .settings-dialog__sidebar {
+    width: 240px;
+    flex-basis: 240px;
+  }
+  .settings-dialog__provider-hero {
+    padding-bottom: 16px;
+  }
+}
+
+.settings-dialog__advanced > summary {
+  cursor: pointer;
+  font-size: 12px;
+  color: var(--td-text-color-secondary, #777);
+  padding: 9px 0;
+}
+.settings-dialog__advanced[open] > summary {
+  margin-bottom: 12px;
+}
+.settings-dialog--assistant .settings-dialog__advanced {
+  border: 1px solid var(--td-component-border, #e7e4df);
+  border-radius: 10px;
+  padding: 3px 12px;
+}
+.settings-dialog--assistant .settings-dialog__provider-tag {
+  white-space: nowrap;
+}
+.settings-dialog--assistant
+  .settings-dialog__grid
+  > .settings-dialog__advanced {
+  order: 5;
+}
+
+.settings-dialog--assistant .settings-dialog__layout {flex:1;min-height:0;}
+.settings-dialog__assistant-footer {flex:none;display:flex;align-items:center;gap:10px;padding:12px 22px;border-top:1px solid var(--sd-border);background:var(--sd-surface);font-size:12px;}
+.settings-dialog__assistant-footer > span {flex:1;color:var(--sd-muted);}
+.settings-dialog__assistant-footer .settings-dialog__button--primary {background:var(--sd-text);color:var(--sd-surface);border-color:transparent;}
+
+.settings-dialog--assistant [hidden] { display:none !important; }
+.creative-root[data-theme=dark] .winbox-settings-window {
+  --td-bg-color-container:#292925;
+  --td-bg-color-secondarycontainer:#34342f;
+  --td-text-color-primary:#e6e4df;
+  --td-text-color-secondary:#aaa89e;
+  --td-component-border:#48473f;
+  --td-brand-color:#d6a65d;
+}
+.creative-root[data-theme=dark] .winbox-settings-window :is(.wb-header,.wb-body,.winbox-content-wrapper,.settings-dialog) {
+  background:#292925 !important;color:#e6e4df;
+}
+.creative-root[data-theme=dark] .winbox-settings-window .wb-title {color:#e6e4df;}
+.creative-root[data-theme=dark] .winbox-settings-window .wb-icon {filter:none;}
+.creative-root[data-theme=dark] .settings-dialog--assistant {
+  --sd-text:#e6e4df;--sd-muted:#aaa89e;--sd-border:#48473f;--sd-border-strong:#5b594f;--sd-surface:#292925;--sd-surface-soft:#34342f;
+}
+.creative-root[data-theme=dark] .settings-dialog--assistant :is(.settings-dialog__workspace,.settings-dialog__content-panel,.settings-dialog__sidebar,.settings-dialog__input,.settings-dialog__select,.settings-dialog__model-type-group,.settings-dialog__custom-model-panel,.settings-dialog__preference,.settings-dialog__compat-card) {
+  background:var(--sd-surface);color:var(--sd-text);border-color:var(--sd-border);
+}
+.creative-root[data-theme=dark] .settings-dialog--assistant :is(.settings-dialog__nav-item--active,.settings-dialog__provider-row--active,.settings-dialog__model-type-header,.settings-dialog__model-row,.settings-dialog__button) {
+  background:var(--sd-surface-soft);color:var(--sd-text);border-color:var(--sd-border);
+}
+.creative-root[data-theme=dark] .settings-dialog--assistant .settings-dialog__button--primary {background:#e6e4df;color:#292925;}
+.creative-root[data-theme=dark] .settings-dialog--assistant :is(.settings-dialog__label,.settings-dialog__field-hint,.settings-dialog__custom-model-error) {color:var(--sd-text);}
+.creative-root[data-theme=dark] .settings-dialog--assistant :is(.settings-dialog__main,.settings-dialog__workspace,.settings-dialog__content-panel,.settings-dialog__sidebar,.settings-dialog__assistant-footer) {border-color:var(--sd-border) !important;}
+.creative-root[data-theme=dark] .winbox-settings-window :is(.wb-close,.wb-full,.wb-max,.wb-split) {filter:none !important;}
+.creative-root[data-theme=dark] .winbox-settings-window .wb-header {background-image:none !important;}
+.settings-dialog--assistant .assistant-account-binding {margin-bottom:12px;padding:12px;}
+.settings-dialog--assistant .assistant-account-binding__status {margin:8px 0;}
+.settings-dialog--assistant .assistant-account-binding__selected {padding:9px !important;}
+
+// Keep the shared footer independent of the original compact form's full-width buttons.
+.settings-dialog--assistant .settings-dialog__assistant-footer {
+  flex-wrap: wrap;
+  > span { flex: 1 1 180px; min-width: 0; }
+  > .settings-dialog__button { flex: 0 0 auto; width: auto; min-width: 64px; }
+}
+
+.creative-root[data-theme=dark] .settings-dialog--assistant {
+  color-scheme: dark;
+  :is(.settings-dialog__route-card, .settings-dialog__endpoint-panel, .settings-dialog__endpoint-row,
+      .settings-dialog__sidebar-item, .settings-dialog__ghost-button, .settings-dialog__sidebar-add,
+      .settings-dialog__endpoint-test-btn, .settings-dialog__endpoint-add-btn, .settings-dialog__endpoint-remove) {
+    background: var(--sd-surface-soft); color: var(--sd-text); border-color: var(--sd-border);
+  }
+  .settings-dialog__sidebar-item--active { background: #454137; }
+  .settings-dialog__endpoint-add input { background: var(--sd-surface); color: var(--sd-text); }
+  .project-drawer-tts { background: var(--sd-surface); }
+  .project-drawer-tts__slider-value { color: #e8b959; }
+  :is(.project-drawer-tts__hint, .project-drawer-tts__empty) { color: var(--sd-muted); }
+}
+.creative-root[data-theme=dark] .settings-dialog--assistant {
+  :is(.settings-dialog__endpoint-row-url, .settings-dialog__endpoint-row-name) { color: var(--sd-text); }
+  :is(.settings-dialog__route-clear, .settings-dialog__compat-card, .settings-dialog__compat-card strong,
+      .settings-dialog__compat-card span, .settings-dialog__sidebar-badge--accent) { color: #e8b959; }
+  :is(.settings-dialog__endpoint-error, .settings-dialog__danger-button) { color: #f59d92; }
+}
