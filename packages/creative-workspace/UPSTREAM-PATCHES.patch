+    list-style: disc;
+  }
+  ol {
+    list-style: decimal;
+  }
+}
+.text-chat-composer > textarea:focus-visible {
+  outline: none;
+}
+
+.text-chat-workspace .model-selector--variant-capsule .model-selector__trigger {
+  color: var(--tc-ink);
+  background: var(--tc-panel);
+  max-width: 100%;
+}
+.text-chat-workspace .model-selector__trigger-icon {
+  color: var(--tc-soft);
+}
+
+.text-chat-messages--virtual {
+  display: block;
+  position: relative;
+  padding-top: 0;
+  padding-bottom: 0;
+}
+.text-chat-virtual-row {
+  position: absolute;
+  top: 0;
+  left: 28px;
+  right: 28px;
+  display: flex;
+  flex-direction: column;
+  .text-chat-answer {
+    content-visibility: visible;
+    contain-intrinsic-size: none;
+  }
+}
+@media (max-width: 760px) {
+  .text-chat-virtual-row {
+    left: 18px;
+    right: 18px;
+  }
+}
+
+.text-chat-attachments {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  margin: 6px 0 10px;
+  white-space: normal;
+}
+.text-chat-attachment {
+  position: relative;
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  width: min(260px, 100%);
+  min-width: 0;
+  border: 1px solid var(--tc-line, #e1e4dc);
+  border-radius: 12px;
+  background: var(--tc-panel, #f6f7f2);
+  overflow: hidden;
+}
+.text-chat-attachment-open {
+  display: flex;
+  align-items: center;
+  gap: 9px;
+  flex: 1;
+  min-width: 0;
+  padding: 9px;
+  text-align: left;
+  border: 0;
+  background: transparent;
+  color: inherit;
+  cursor: pointer;
+}
+.text-chat-attachment-open > img {
+  width: 44px;
+  height: 44px;
+  border-radius: 7px;
+  object-fit: cover;
+  flex-shrink: 0;
+}
+.text-chat-attachment-open > svg {
+  width: 24px;
+  height: 24px;
+  flex-shrink: 0;
+  color: #6b7c60;
+}
+.text-chat-attachment-open > span {
+  min-width: 0;
+}
+.text-chat-attachment-open strong {
+  display: block;
+  font-size: 12px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.text-chat-attachment-open small {
+  display: block;
+  font-size: 10px;
+  opacity: 0.65;
+  margin-top: 4px;
+}
+.text-chat-attachment-remove {
+  flex-shrink: 0;
+  margin-right: 6px;
+  width: 24px;
+  height: 24px;
+  border: 0;
+  border-radius: 6px;
+  background: transparent;
+  color: inherit;
+  cursor: pointer;
+}
+.text-chat-attachment-remove:hover {
+  background: #e4e8de;
+}
+.text-chat-attachment-warning {
+  display: block;
+  width: 100%;
+  padding: 0 9px 8px;
+  font-size: 11px;
+  color: #956224;
+}
+.text-chat-attachment-progress {
+  display: flex;
+  gap: 7px;
+  align-items: center;
+  font-size: 12px;
+  padding: 4px 0 10px;
+}
+.text-chat-attachment-progress button {
+  margin-left: auto;
+  border: 0;
+  background: transparent;
+  color: inherit;
+  cursor: pointer;
+}
+.text-chat-file-drag {
+  outline: 2px dashed #8a9c7b;
+  outline-offset: -4px;
+}
+.text-chat-drop-hint {
+  pointer-events: none;
+  position: absolute;
+  inset: 45% 15% auto;
+  z-index: 20;
+  padding: 18px;
+  text-align: center;
+  background: #edf2e6;
+  color: #425337;
+  border-radius: 14px;
+  box-shadow: 0 4px 24px #0001;
+}
+.text-chat-attachment-backdrop {
+  position: fixed;
+  inset: 0;
+  z-index: 31000;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 24px;
+  background: #17201680;
+  white-space: normal;
+}
+.text-chat-attachment-preview {
+  width: min(880px, 100%);
+  max-height: 85vh;
+  overflow: auto;
+  border-radius: 16px;
+  padding: 20px;
+  background: #fcfcf9;
+  color: #30372d;
+  box-shadow: 0 12px 50px #0003;
+}
+.text-chat-attachment-preview header {
+  display: flex;
+  gap: 16px;
+  align-items: center;
+  justify-content: space-between;
+  margin-bottom: 14px;
+  overflow-wrap: anywhere;
+}
+.text-chat-attachment-preview header button {
+  flex-shrink: 0;
+  border: 0;
+  background: transparent;
+  color: inherit;
+  cursor: pointer;
+}
+.text-chat-attachment-preview > img {
+  max-width: 100%;
+  max-height: 65vh;
+  object-fit: contain;
+  display: block;
+  margin: auto;
+}
+.text-chat-attachment-preview pre {
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+  font-size: 13px;
+  line-height: 1.65;
+}
+.text-chat-attachment-preview small {
+  opacity: 0.65;
+}
+.creative-root[data-theme="dark"] .text-chat-attachment {
+  background: #262c24;
+  border-color: #3b4235;
+  color: #e1e7da;
+}
+.creative-root[data-theme="dark"] .text-chat-attachment-preview {
+  background: #252b23;
+  color: #e1e7da;
+}
+.creative-root[data-theme="dark"] .text-chat-attachment-remove:hover {
+  background: #3b4235;
+}
+
+.creative-root[data-theme="dark"] .text-chat-attachment-open > svg {
+  color: #b7c7a9;
+}
+.creative-root[data-theme="dark"] .text-chat-attachment-warning {
+  color: #e5bd83;
+}
+
+.text-chat-discussion-mode { white-space: nowrap; font-size: 12px; }
+.discussion-results { display: grid; gap: 10px; margin: 12px 0; }
+.discussion-result { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; min-width: 0; }
+.discussion-result-media { width: 100%; display: flex; flex-wrap: wrap; gap: 8px; }
+.discussion-result-media img, .discussion-result-media video { width: min(100%, 240px); max-height: 260px; object-fit: contain; border-radius: 10px; }
+.discussion-result small { color: var(--text-color-secondary, #777); overflow-wrap: anywhere; }
+.discussion-result button { display: inline-flex; gap: 4px; align-items: center; }
+
+// Leave room for the canvas composer in side-by-side discussion.
+.chat-drawer--text:not(.chat-drawer--text-focus) { max-width: 50vw; }
+.discussion-result-media .workflow-bubble__media-item { width: 100%; min-height: 120px; position: relative; }
+.discussion-result-media .workflow-bubble__media-preview { width: 100%; max-height: 220px; object-fit: contain; }
+
+.text-chat-user > small.text-chat-status { display: block; margin-bottom: 6px; font-size: 11px; }
+
+.text-chat-workspace--attached {
+  --tc-paper: #fffefa; --tc-panel: #f4f5f0; --tc-line: #e7e9e0;
+  width: 100%; min-width: 0;
+  .text-chat-header { padding: 9px 12px; gap: 6px; min-height: 49px; }
+  .attached-discussion-heading { display: flex; align-items: baseline; gap: 9px; min-width: 0; }
+  .attached-discussion-heading strong { font-size: 13px; white-space: nowrap; }
+  .attached-discussion-heading span { font-size: 11px; color: var(--tc-soft); white-space: nowrap; }
+  .text-chat-title { padding: 0 16px 5px; font-size: 11px; }
+  .text-chat-title button { min-height: 23px; padding: 0; color: var(--tc-soft); }
+  .text-chat-scroll { overscroll-behavior: contain; scrollbar-gutter: stable; }
+  .text-chat-messages { padding: 8px 18px 16px; gap: 18px; }
