+import { beforeEach, expect, it, vi } from "vitest";
+const state = vi.hoisted(() => ({ records: new Map<string, any>() }));
+vi.mock("localforage", () => ({
+  default: {
+    createInstance: () => ({
+      setItem: async (k: string, v: unknown) => state.records.set(k, v),
+      getItem: async (k: string) => state.records.get(k),
+      removeItem: async (k: string) => state.records.delete(k),
+      clear: async () => state.records.clear(),
+      iterate: async (f: any) => {
+        for (const [k, v] of state.records) f(v, k);
+      },
+    }),
+  },
+}));
+import {
+  attachmentFileKind,
+  saveTextAttachment,
+  readTextAttachment,
+  removeSessionAttachments,
+  clearTextAttachments,
+  validateAttachmentRefs,
+  validateAttachmentRecord,
+} from "./attachments";
+import { prepareTextAttachment } from "./attachment-prepare";
+import { textBody } from "./protocol";
+const ref = {
+  id: "a",
+  name: "notes.md",
+  kind: "document" as const,
+  mimeType: "text/plain",
+  size: 20,
+};
+const image = "data:image/jpeg;base64,YWJj";
+beforeEach(() => state.records.clear());
+it("accepts supported extensions and rejects oversized, empty and executable binaries", () => {
+  for (const name of ["notes.md", "main.ts", "main.py", "data.json"])
+    expect(attachmentFileKind({ name, size: 10, type: "" })).toBe("text");
+  expect(attachmentFileKind({ name: "SCAN.PDF", size: 10, type: "" })).toBe(
+    "pdf",
+  );
+  expect(attachmentFileKind({ name: "photo.png", size: 10, type: "" })).toBe(
+    "image",
+  );
+  for (const [name, size] of [
+    ["bad.exe", 10],
+    ["empty.txt", 0],
+    ["huge.md", 3 * 1024 ** 2],
+    ["huge.png", 11 * 1024 ** 2],
+  ] as const)
+    expect(() => attachmentFileKind({ name, size, type: "" })).toThrow();
+});
+it("validates batch limits, duplicate ids and safe local image payloads", () => {
+  expect(() => validateAttachmentRefs([ref, ref])).toThrow();
+  expect(() =>
+    validateAttachmentRefs(
+      Array.from({ length: 7 }, (_, i) => ({ ...ref, id: String(i) })),
+    ),
+  ).toThrow();
+  expect(() =>
+    validateAttachmentRefs([{ ...ref, size: 21 * 1024 ** 2 }]),
+  ).toThrow();
+  for (const dataUrl of [
+    "https://example.invalid/a.png",
+    "data:image/svg+xml;base64,YWJj",
+  ])
+    expect(() =>
+      validateAttachmentRecord({
+        ref: { ...ref, kind: "image" },
+        sessionId: "s",
+        dataUrl,
+      }),
+    ).toThrow();
+});
+it("stores separately, detects missing/corrupt refs, and deletes only the owner session", async () => {
+  await saveTextAttachment({ ref, sessionId: "s", text: "synthetic document" });
+  await saveTextAttachment({
+    ref: { ...ref, id: "b" },
+    sessionId: "other",
+    text: "keep",
+  });
+  expect((await readTextAttachment(ref)).text).toBe("synthetic document");
+  await expect(readTextAttachment({ ...ref, kind: "image" })).rejects.toThrow(
+    "不一致",
+  );
+  await removeSessionAttachments("s");
+  await expect(readTextAttachment(ref)).rejects.toThrow("丢失");
+  expect(state.records.has("b")).toBe(true);
+  state.records.set("a", { ref, sessionId: "s", text: "" });
+  await expect(readTextAttachment(ref)).rejects.toThrow("无效");
+  await clearTextAttachments();
+  expect(state.records.size).toBe(0);
+});
+it("decodes UTF-8 code literally and rejects binary, invalid encoding and oversized extracted text", async () => {
+  const file = (bytes: Uint8Array) =>
+    ({
+      name: "test.ts",
+      type: "text/plain",
+      size: bytes.length,
+      arrayBuffer: async () => bytes.buffer,
+    }) as File;
+  const prepare = (bytes: Uint8Array) =>
+    prepareTextAttachment(file(bytes), "s", new AbortController().signal);
+  const result = await prepare(
+    new TextEncoder().encode('const 中文 = "<script>";'),
+  );
+  expect(result.text).toBe('const 中文 = "<script>";');
+  expect(result.ref.kind).toBe("document");
+  await expect(prepare(new Uint8Array([0, 1, 2]))).rejects.toThrow("二进制");
+  await expect(prepare(new Uint8Array([255, 254]))).rejects.toThrow("UTF-8");
+  await expect(
+    prepare(new TextEncoder().encode("a".repeat(80001))),
+  ).rejects.toThrow("8 万");
+  const controller = new AbortController();
+  controller.abort();
+  await expect(
+    prepareTextAttachment(file(new Uint8Array([1])), "s", controller.signal),
+  ).rejects.toMatchObject({ name: "AbortError" });
+});
+it("serializes all four image protocols without leaking storage references", () => {
+  const turns = [
+    {
+      role: "user" as const,
+      content: "describe",
+      images: [image],
+      attachments: [ref],
+    },
+  ];
+  expect(textBody("chat", "m", turns)).toMatchObject({
+    messages: [
+      {
+        role: "user",
+        content: [
+          { type: "text", text: "describe" },
+          { type: "image_url", image_url: { url: image } },
+        ],
+      },
+    ],
+  });
+  expect(textBody("responses", "m", turns)).toMatchObject({
+    input: [
+      {
+        content: [
+          { type: "input_text", text: "describe" },
+          { type: "input_image", image_url: image, detail: "auto" },
+        ],
+      },
+    ],
+  });
+  expect(textBody("anthropic", "m", turns)).toMatchObject({
+    messages: [
+      {
+        content: [
+          {
+            type: "image",
+            source: { type: "base64", media_type: "image/jpeg", data: "YWJj" },
+          },
+          { type: "text", text: "describe" },
+        ],
+      },
+    ],
+  });
+  expect(textBody("gemini", "m", turns)).toMatchObject({
+    contents: [
+      {
+        parts: [
+          { text: "describe" },
+          { inlineData: { mimeType: "image/jpeg", data: "YWJj" } },
+        ],
+      },
+    ],
+  });
+  for (const protocol of [
+    "chat",
+    "responses",
+    "anthropic",
+    "gemini",
+  ] as const) {
+    expect(JSON.stringify(textBody(protocol, "m", turns))).not.toContain(
+      "notes.md",
+    );
+    expect(
+      JSON.stringify(textBody(protocol, "m", [{ ...turns[0], content: "" }])),
+    ).not.toContain('"text":""');
+  }
+});
diff --git a/packages/drawnix/src/services/text-chat/attachments.ts b/packages/drawnix/src/services/text-chat/attachments.ts
new file mode 100644
index 0000000..b149833
--- /dev/null
+++ b/packages/drawnix/src/services/text-chat/attachments.ts
@@ -0,0 +1,166 @@
+import localforage from "localforage";
+
+export const TEXT_ATTACHMENT_STORE = "text_attachments";
+export const ATTACHMENT_LIMITS = {
+  count: 6,
+  totalBytes: 20 * 1024 ** 2,
+  imageBytes: 10 * 1024 ** 2,
+  pdfBytes: 10 * 1024 ** 2,
+  textBytes: 2 * 1024 ** 2,
+  textChars: 80000,
+  pdfPages: 50,
+};
+export const ATTACHMENT_ACCEPT =
+  ".png,.jpg,.jpeg,.webp,.pdf,.txt,.md,.markdown,.csv,.json,.jsonl,.yaml,.yml,.xml,.html,.css,.scss,.js,.jsx,.ts,.tsx,.py,.rs,.go,.java,.c,.h,.cpp,.hpp,.cs,.rb,.php,.sh,.sql,.toml,.ini,.log";
+export interface TextAttachmentRef {
+  id: string;
+  name: string;
+  kind: "image" | "document";
+  mimeType: string;
+  size: number;
+  textLength?: number;
+  pages?: number;
+  warning?: string;
+}
+export interface TextAttachmentRecord {
+  ref: TextAttachmentRef;
+  sessionId: string;
+  text?: string;
+  dataUrl?: string;
+  thumbnailDataUrl?: string;
+}
+let store: LocalForage | undefined;
+function db() {
+  return (store ??= localforage.createInstance({
+    name: "aitu-chat",
+    storeName: TEXT_ATTACHMENT_STORE,
+  }));
+}
+export function validateAttachmentRefs(
+  refs: unknown,
+): asserts refs is TextAttachmentRef[] {
+  if (
+    !Array.isArray(refs) ||
+    refs.length > ATTACHMENT_LIMITS.count ||
+    refs.some(
+      (a) =>
+        !a ||
+        typeof a.id !== "string" ||
+        !a.id ||
+        a.id.length > 200 ||
+        typeof a.name !== "string" ||
+        a.name.length > 200 ||
+        !["image", "document"].includes(a.kind) ||
+        typeof a.mimeType !== "string" ||
+        !Number.isSafeInteger(a.size) ||
+        a.size < 0 ||
+        (a.warning !== undefined &&
+          (typeof a.warning !== "string" || a.warning.length > 2000)) ||
+        (a.pages !== undefined &&
+          (!Number.isInteger(a.pages) ||
+            a.pages < 1 ||
+            a.pages > ATTACHMENT_LIMITS.pdfPages)) ||
+        (a.textLength !== undefined &&
+          (!Number.isInteger(a.textLength) ||
+            a.textLength < 1 ||
+            a.textLength > ATTACHMENT_LIMITS.textChars)),
+    ) ||
+    new Set(refs.map((a) => a.id)).size !== refs.length ||
+    refs.reduce((n, a) => n + a.size, 0) > ATTACHMENT_LIMITS.totalBytes
+  ) {
+    throw new Error(
+      "每条消息最多 6 个附件，原文件合计不超过 20 MB；附件信息需完整。",
+    );
+  }
+}
+export function validateAttachmentRecord(
+  record: unknown,
+): asserts record is TextAttachmentRecord {
+  const r = record as TextAttachmentRecord;
+  if (
+    !r ||
+    typeof r.sessionId !== "string" ||
+    !r.sessionId ||
+    r.sessionId.length > 200
+  )
+    throw new Error("附件数据不完整，请重新添加。");
+  validateAttachmentRefs([r.ref]);
+  if (r.ref.kind === "image") {
+    if (
+      typeof r.dataUrl !== "string" ||
+      r.dataUrl.length > 3 * 1024 ** 2 ||
+      !/^data:image\/(png|jpeg|webp);base64,[A-Za-z0-9+/]+={0,2}$/.test(
+        r.dataUrl,
+      )
+    )
+      throw new Error("图片附件格式无效，请重新添加。");
+    if (
+      r.thumbnailDataUrl !== undefined &&
+      (typeof r.thumbnailDataUrl !== "string" ||
+        r.thumbnailDataUrl.length > 100000 ||
+        !/^data:image\/jpeg;base64,[A-Za-z0-9+/]+={0,2}$/.test(
+          r.thumbnailDataUrl,
+        ))
+    )
+      throw new Error("图片缩略图格式无效，请重新添加。");
+  } else if (
+    typeof r.text !== "string" ||
+    !r.text.trim() ||
+    r.text.length > ATTACHMENT_LIMITS.textChars
+  ) {
+    throw new Error("文档附件内容无效，请重新添加。");
+  }
+}
+export async function saveTextAttachment(record: TextAttachmentRecord) {
+  validateAttachmentRecord(record);
+  await db().setItem(record.ref.id, record);
+}
+export async function readTextAttachment(
+  ref: TextAttachmentRef,
+): Promise<TextAttachmentRecord> {
+  const record = await db().getItem<TextAttachmentRecord>(ref.id);
+  if (!record) throw new Error(`附件“${ref.name}”已丢失，请重新添加后发送。`);
+  validateAttachmentRecord(record);
+  if (record.ref.id !== ref.id || record.ref.kind !== ref.kind)
+    throw new Error("附件引用与内容不一致，请重新添加。");
+  return record;
+}
+export async function removeTextAttachment(id: string) {
+  await db().removeItem(id);
+}
+export async function removeSessionAttachments(sessionId: string) {
+  const ids: string[] = [];
+  await db().iterate<TextAttachmentRecord, void>((r, key) => {
+    if (r?.sessionId === sessionId) ids.push(key);
+  });
+  for (const id of ids) await db().removeItem(id);
+}
+export async function clearTextAttachments() {
+  await db().clear();
+}
+
+export function attachmentFileKind(
+  file: Pick<File, "name" | "size" | "type">,
+): "image" | "pdf" | "text" {
+  const ext = "." + file.name.split(".").pop()!.toLowerCase();
+  const kind = [".png", ".jpg", ".jpeg", ".webp"].includes(ext)
+    ? "image"
+    : ext === ".pdf"
+      ? "pdf"
+      : ATTACHMENT_ACCEPT.split(",").includes(ext)
+        ? "text"
+        : null;
+  if (!kind)
+    throw new Error("支持 PNG/JPEG/WebP、PDF、TXT/Markdown 和常见代码文件。");
+  const limit =
+    kind === "image"
+      ? ATTACHMENT_LIMITS.imageBytes
+      : kind === "pdf"
+        ? ATTACHMENT_LIMITS.pdfBytes
+        : ATTACHMENT_LIMITS.textBytes;
+  if (!file.size || file.size > limit)
+    throw new Error(
+      `“${file.name}”为空或过大：${kind === "text" ? "文本最多 2" : "图片/PDF 最多 10"} MB。`,
+    );
+  return kind;
+}
