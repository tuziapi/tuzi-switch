+import { sanitizeGenerationDiagnosticText } from './image-error-details';
+/** Shared provider diagnostics; image exports remain compatible with existing callers. */
+export {
+  createImageApiError as createGenerationApiError,
+  readImageApiError as readGenerationApiError,
+  toImageTaskError as toGenerationTaskError,
+  getImageFailureDetails as getGenerationFailureDetails,
+  extractImageErrorDiagnostics as extractGenerationErrorDiagnostics,
+} from './image-error-details';
+export type { ImageErrorDiagnostics as GenerationErrorDiagnostics } from './image-error-details';
+
+/** Match the visible fields, with indented continuation lines for multiline errors. */
+export function formatGenerationErrorReport(
+  rows: readonly (readonly [string, string])[]
+): string {
+  return rows
+    .map(
+      ([label, value]) =>
+        `${label}：${sanitizeGenerationDiagnosticText(value).replace(/\r\n?/g, '\n').replace(/\n/g, '\n  ')}`
+    )
+    .join('\n');
+}
diff --git a/packages/drawnix/src/utils/image-batch-preparation.ts b/packages/drawnix/src/utils/image-batch-preparation.ts
new file mode 100644
index 0000000..6e8de87
--- /dev/null
+++ b/packages/drawnix/src/utils/image-batch-preparation.ts
@@ -0,0 +1,122 @@
+import { PlaitBoard, type Point } from "@plait/core";
+import { parseSizeToPixels } from "./size-ratio";
+import { resolveImageLineagePositions } from "./image-generation-lineage-placement";
+import { resolveImageGenerationBatchAnchorPositions } from "./image-generation-anchor-placement";
+import {
+  reserveImageBatch,
+  type BatchReservation,
+} from "./image-batch-reservations";
+
+// Preparation is visual only: never save speculative tasks or React roots to the board.
+export function createImageBatchPreparation(
+  board: PlaitBoard,
+  options: {
+    count: number;
+    requestedSize?: string;
+    sourceIds: string[];
+    emptyPosition: Point;
+    frameRect?: BatchReservation;
+    hasUnplacedReferences?: boolean;
+  },
+) {
+  const size = parseSizeToPixels(options.requestedSize);
+  const reservedSize = {
+    width: Math.max(400, size.width),
+    height: Math.max(600, size.height),
+  };
+  const origin: Point =
+    options.hasUnplacedReferences && !options.sourceIds.length
+      ? [options.emptyPosition[0] + 520, options.emptyPosition[1]]
+      : options.emptyPosition;
+  const positions = options.frameRect
+    ? resolveImageGenerationBatchAnchorPositions(
+        board,
+        origin,
+        reservedSize,
+        options.count,
+        { frameRect: options.frameRect },
+      )
+    : resolveImageLineagePositions(
+        board,
+        options.sourceIds,
+        reservedSize,
+        options.count,
+        origin,
+        "grid",
+      );
+  const columns = Math.min(3, options.count);
+  const rows = Math.ceil(options.count / columns);
+  const release = reserveImageBatch(board, {
+    x: positions[0][0],
+    y: positions[0][1],
+    width: columns * reservedSize.width + (columns - 1) * 40,
+    height: rows * reservedSize.height + (rows - 1) * 40,
+  });
+  const ns = "http://www.w3.org/2000/svg";
+  const layer = document.createElementNS(ns, "g");
+  layer.classList.add("image-batch-preparation");
+  layer.setAttribute("pointer-events", "none");
+  for (const [index, [x, y]] of positions.entries()) {
+    const slot = document.createElementNS(ns, "g");
+    slot.classList.add("batch-preparation-slot");
+    slot.setAttribute("aria-label", `准备生成 ${index + 1}/${options.count}`);
+    const rect = document.createElementNS(ns, "rect");
+    for (const [key, value] of Object.entries({
+      x,
+      y,
+      width: size.width,
+      height: size.height,
+      rx: 16,
+      fill: "#f8fafc",
+      stroke: "#cbd5e1",
+      "stroke-width": 1,
+    }))
+      rect.setAttribute(key, String(value));
+    const label = document.createElementNS(ns, "text");
+    label.setAttribute("x", String(x + size.width / 2));
+    label.setAttribute("y", String(y + size.height / 2));
+    label.setAttribute("text-anchor", "middle");
+    label.setAttribute("fill", "#64748b");
+    label.setAttribute("font-size", "16");
+    label.textContent = `准备生成 · ${index + 1}/${options.count}`;
+    slot.append(rect, label);
+    layer.append(slot);
+  }
+  try {
+    PlaitBoard.getElementHost(board).append(layer);
+  } catch (error) {
+    release();
+    throw error;
+  }
+  let disposed = false;
+  return {
+    count: options.count,
+    positions,
+    size,
+    reservedSize,
+    dispose() {
+      if (!disposed) {
+        disposed = true;
+        layer.remove();
+        release();
+      }
+    },
+  };
+}
+
+// Two frames allow a complete SVG preview to be painted before async preparation.
+// Hidden windows use a bounded timer so background submission cannot hang.
+export function yieldBatchPreparationPaint(): Promise<void> {
+  return new Promise((resolve) => {
+    let frame = 0;
+    const finish = () => {
+      clearTimeout(timer);
+      cancelAnimationFrame(frame);
+      resolve();
+    };
+    const timer = setTimeout(finish, 100);
+    frame = requestAnimationFrame(() => {
+      frame = requestAnimationFrame(finish);
+    });
+  });
+}
diff --git a/packages/drawnix/src/utils/image-batch-reservations.ts b/packages/drawnix/src/utils/image-batch-reservations.ts
new file mode 100644
index 0000000..0127b4a
--- /dev/null
+++ b/packages/drawnix/src/utils/image-batch-reservations.ts
@@ -0,0 +1,25 @@
+import type { PlaitBoard } from "@plait/core";
+export type BatchReservation = {
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+};
+const reservations = new WeakMap<PlaitBoard, Set<BatchReservation>>();
+export function getBatchReservations(board: PlaitBoard): BatchReservation[] {
+  return [...(reservations.get(board) ?? [])];
+}
+export function reserveImageBatch(
+  board: PlaitBoard,
+  rect: BatchReservation,
+): () => void {
+  let entries = reservations.get(board);
+  if (!entries) {
+    entries = new Set();
+    reservations.set(board, entries);
+  }
+  entries.add(rect);
+  return () => {
+    entries.delete(rect);
+  };
+}
diff --git a/packages/drawnix/src/utils/image-error-details.ts b/packages/drawnix/src/utils/image-error-details.ts
new file mode 100644
index 0000000..49b6968
--- /dev/null
+++ b/packages/drawnix/src/utils/image-error-details.ts
@@ -0,0 +1,222 @@
+import type { Task, TaskError } from '../types/shared/core.types';
+
+/** Provider metadata only: never store headers, credentials or image payloads. */
+export interface ImageErrorDiagnostics {
+  /** Original video submission ID returned by the API site, not its upstream. */
+  apiRequestId?: string;
+  requestId?: string;
+  apiErrorCode?: string;
+  httpStatus?: number;
+  modelId?: string;
+  remoteId?: string;
+}
+
+type DiagnosticError = Error & {
+  diagnostics?: ImageErrorDiagnostics;
+  httpStatus?: number;
+  apiErrorBody?: string;
+  fullResponse?: string;
+};
+
+/** Redact credential-shaped provider echoes before persistence, display or copying. */
+export function sanitizeGenerationDiagnosticText(value: string): string {
+  return value
+    .replace(/(["']?(?:api[_-]?key|access[_-]?token|refresh[_-]?token|authorization|password|secret|credential)["']?\s*[:=]\s*)(?:"[^"]*"|'[^']*'|(?:Bearer\s+)?[^\s,;&}\]]+)/gi, '$1[REDACTED]')
+    .replace(/\bBearer\s+[A-Za-z0-9._~+/-]+=*/gi, 'Bearer [REDACTED]')
+    .replace(/\bsk-[A-Za-z0-9_-]{8,}\b/g, '[REDACTED]');
+}
+
+const object = (value: unknown): Record<string, unknown> =>
+  value && typeof value === 'object' && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : {};
+const text = (value: unknown): string | undefined =>
+  typeof value === 'string' && value.trim()
+    ? value.trim()
+    : typeof value === 'number' && Number.isFinite(value)
+    ? String(value)
+    : undefined;
+
+function parse(value: unknown): unknown {
+  if (typeof value !== 'string') return value;
+  try {
+    return JSON.parse(value);
+  } catch {
+    return value;
+  }
+}
+
+const REQUEST_ID_PATTERN = String.raw`\brequest[\s_-]*id\s*[:=]\s*([\w.:-]+)`;
+
+function embeddedRequestId(value: unknown): string | undefined {
+  return typeof value === 'string'
+    ? value.match(new RegExp(REQUEST_ID_PATTERN, 'i'))?.[1]
+    : undefined;
+}
+
+export function extractImageErrorDiagnostics(
+  value: unknown
+): ImageErrorDiagnostics {
+  const parsed = parse(value);
+  const body = object(parsed);
+  const error = object(body.error);
+  const data = object(body.data);
+  return {
+    requestId:
+      embeddedRequestId(error.message) ||
+      embeddedRequestId(body.message) ||
+      embeddedRequestId(body.error) ||
+      text(body.request_id ?? body.requestId) ||
+      text(error.request_id ?? error.requestId) ||
+      text(data.request_id ?? data.requestId) ||
+      embeddedRequestId(value),
+    apiErrorCode: text(error.code) || text(body.code),
+    remoteId:
+      text(body.task_id ?? body.taskId) ||
+      text(error.task_id ?? error.taskId) ||
+      text(data.task_id ?? data.taskId),
+  };
+}
+
+function defined(diagnostics: ImageErrorDiagnostics): ImageErrorDiagnostics {
+  return Object.fromEntries(
+    Object.entries(diagnostics).filter(([, value]) => value !== undefined).map(([key, value]) => [key, typeof value === 'string' ? sanitizeGenerationDiagnosticText(value) : value])
+  );
+}
+
+export function createImageApiError(
+  body: unknown,
+  response: Pick<Response, 'status' | 'headers'>,
+  fallback: string,
+  context: Pick<ImageErrorDiagnostics, 'modelId' | 'remoteId'> = {}
+): DiagnosticError {
+  const parsed = parse(body);
+  const record = object(parsed);
+  const errorBody = object(record.error);
+  const message =
+    text(errorBody.message) ||
+    text(record.error) ||
+    text(record.message) ||
+    (typeof parsed === 'string' && !/^<!doctype|^<html/i.test(parsed.trim())
+      ? parsed.trim()
+      : '') ||
+    fallback;
+  const extracted = extractImageErrorDiagnostics(body);
+  const error: DiagnosticError = new Error(sanitizeGenerationDiagnosticText(message));
+  error.httpStatus = response.status;
+  error.diagnostics = defined({
+    ...extracted,
+    requestId:
+      // The provider's error message can identify the upstream request,
+      // while x-request-id identifies a different gateway hop.
+      extracted.requestId ||
+      response.headers?.get('x-oneapi-request-id') ||
+      response.headers?.get('x-request-id') ||
+      response.headers?.get('request-id') ||
+      undefined,
+    httpStatus: response.status,
+    ...defined(context),
+  });
+  return error;
+}
+
+export async function readImageApiError(
+  response: Response,
+  fallback: string,
+  context: Pick<ImageErrorDiagnostics, 'modelId' | 'remoteId'> = {},
+  readBody: (response: Response) => Promise<string> = (response) =>
+    response.text()
+): Promise<DiagnosticError> {
+  // Read once so non-JSON responses remain available too.
+  const body = await readBody(response).catch(() => '');
+  let endpoint = '';
+  try {
+    const url = new URL(response.url);
+    endpoint = `${url.hostname}${url.pathname}`;
+  } catch {
+    // Synthetic responses may not carry an endpoint.
+  }
+  return createImageApiError(
+    body,
+    response,
+    `${fallback}: ${response.status}${endpoint ? ` (${endpoint})` : ''}`,
+    context
+  );
+}
+
+export function toImageTaskError(
+  value: unknown,
+  code: string,
+  modelId?: string
+) {
+  const error = value as DiagnosticError;
+  const message = sanitizeGenerationDiagnosticText(error?.message || String(value));
+  const originalError = sanitizeGenerationDiagnosticText(error?.fullResponse || error?.apiErrorBody || message);
+  const diagnostics = {
+    ...defined(extractImageErrorDiagnostics(message)),
+    ...defined(extractImageErrorDiagnostics(originalError)),
+    ...defined({ modelId, httpStatus: error?.httpStatus }),
+    ...defined(error?.diagnostics || {}),
+  };
+  diagnostics.requestId =
+    embeddedRequestId(message) ||
+    embeddedRequestId(originalError) ||
+    diagnostics.requestId;
+  return {
+    code,
+    message,
+    details: { originalError, timestamp: Date.now(), ...diagnostics },
+  } satisfies TaskError;
+}
+
+export function getImageFailureDetails(task?: Task | null, fallbackError = '') {
+  const error = task?.error;
+  const diagnostics = {
+    ...defined(extractImageErrorDiagnostics(fallbackError)),
+    ...defined(extractImageErrorDiagnostics(error?.message)),
+    ...defined(extractImageErrorDiagnostics(error?.details?.originalError)),
+    ...defined(error?.details || {}),
+  };
+  // Also repair display of previously saved tasks with a gateway header ID.
+  const requestId =
+    embeddedRequestId(error?.message) ||
+    embeddedRequestId(error?.details?.originalError) ||
+    embeddedRequestId(fallbackError) ||
+    diagnostics.requestId;
+  let message = sanitizeGenerationDiagnosticText(error?.message || fallbackError);
+  if (requestId) {
+    message = message.replace(
+      new RegExp(`\\s*[（(]${REQUEST_ID_PATTERN}\\s*[)）]`, 'gi'),
+      (match, id) => (id === requestId ? '' : match)
+    );
+    // Remove explicit trailing IDs from provider/gateway hops, but keep prose.
+    message = message.replace(
+      new RegExp(
+        `(?:\\s*[（(]${REQUEST_ID_PATTERN}\\s*[)）]|(?:\\s+|^)${REQUEST_ID_PATTERN})+\\s*$`,
+        'i'
+      ),
+      ''
+    );
+  }
+  const status =
+    diagnostics.httpStatus ||
+    Number(error?.code?.match(/^HTTP_(\d{3})$/)?.[1]) ||
+    undefined;
+  if (status) {
+    message = message.replace(new RegExp(`^HTTP\\s+${status}\\s*[:：-]\\s*`, 'i'), '');
+  }
+  const prefix = [status ? `HTTP ${status}` : '', diagnostics.apiErrorCode]
+    .filter(Boolean)
+    .join(' · ');
+  return {
+    requestId,
+    modelId:
+      diagnostics.modelId ||
+      task?.invocationRoute?.modelId ||
+      task?.params?.model ||
+      task?.params?.modelRef?.modelId ||
+      undefined,
+    remoteId: diagnostics.remoteId || task?.remoteId,
+    error: prefix ? `[${prefix}] ${message}` : message,
+  };
+}
