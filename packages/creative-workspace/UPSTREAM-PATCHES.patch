+    display: flex; flex: 1; flex-direction: column; min-height: 0; width: 100%;
+  }
+  .ai-input-composer-shell--canvas {
+    flex: 1;
+    border-radius: 20px;
+    box-shadow: none;
+    overflow: hidden;
+    padding: 0 20px 16px;
+    transition: none;
+    background: var(--island-bg-color, #fff);
+  }
+  .ai-input-composer-shell__input-area {
+    flex-shrink: 0;
+    max-height: 32%;
+    border: 1px solid var(--color-border, #e3e5df);
+    border-radius: 14px;
+    margin-top: 12px;
+    margin-bottom: 10px;
+  }
+  .attached-discussion {
+    flex: 1; min-height: 0; margin: 0 -20px;
+    display: flex; flex-direction: column;
+  }
+  .attached-discussion__panel {
+    position: relative; inset: auto; flex: 1; min-height: 0;
+    border: 0; border-bottom: 1px solid var(--color-border, #e3e5df);
+    border-radius: 20px 20px 0 0; box-shadow: none;
+  }
+  .discussion-strip { display: none; }
+  .text-chat-header { padding: 16px 20px; }
+  .text-chat-workspace { font-size: 14px; }
+  .text-chat-messages {
+    width: 100%;
+    max-width: none;
+    margin: 0;
+    box-sizing: border-box;
+    padding: 20px 24px 28px;
+    &--virtual { padding-block: 0; }
+  }
+  .text-chat-virtual-row { left: 24px; right: 24px; }
+}
+:root[data-theme='dark'] .ai-input-bar.attached-discussion-modal,
+.creative-root[data-theme='dark'] .ai-input-bar.attached-discussion-modal {
+  background: var(--color-surface-high, #2a2a2a);
+  .ai-input-composer-shell--canvas { background: var(--color-surface-high, #2a2a2a); }
+}
+@media (max-width: 760px), (max-height: 600px) {
+  .ai-input-bar.attached-discussion-modal {
+    width: calc(100% - 24px);
+    height: calc(100% - 24px);
+    border-radius: 14px;
