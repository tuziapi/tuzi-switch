+    .attached-discussion { margin: 0 -12px; }
+    .attached-discussion__panel { border-radius: 14px 14px 0 0; }
+    .text-chat-header { padding: 10px 12px; }
+    .text-chat-messages { padding: 12px 18px 18px; }
