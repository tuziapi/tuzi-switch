+.discussion-result { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; min-width: 0; }
+.discussion-result-media { width: 100%; display: flex; flex-wrap: wrap; gap: 8px; }
+.discussion-result-media img, .discussion-result-media video { width: min(100%, 240px); max-height: 260px; object-fit: contain; border-radius: 10px; }
+.discussion-result small { color: var(--text-color-secondary, #777); overflow-wrap: anywhere; }
+.discussion-result button { display: inline-flex; gap: 4px; align-items: center; }
+
+// Leave room for the canvas composer in side-by-side discussion.
+.chat-drawer--text:not(.chat-drawer--text-focus) { max-width: 50vw; }
+.discussion-result-media .workflow-bubble__media-item { width: 100%; min-height: 120px; position: relative; }
+.discussion-result-media .workflow-bubble__media-preview { width: 100%; max-height: 220px; object-fit: contain; }
+
+.text-chat-user > small.text-chat-status { display: block; margin-bottom: 6px; font-size: 11px; }
+
+.text-chat-workspace--attached {
+  --tc-paper: #fffefa; --tc-panel: #f4f5f0; --tc-line: #e7e9e0;
+  width: 100%; min-width: 0;
+  .text-chat-header { padding: 9px 12px; gap: 6px; min-height: 49px; }
+  .attached-discussion-heading { display: flex; align-items: baseline; gap: 9px; min-width: 0; }
+  .attached-discussion-heading strong { font-size: 13px; white-space: nowrap; }
+  .attached-discussion-heading span { font-size: 11px; color: var(--tc-soft); white-space: nowrap; }
+  .text-chat-title { padding: 0 16px 5px; font-size: 11px; }
+  .text-chat-title button { min-height: 23px; padding: 0; color: var(--tc-soft); }
+  .text-chat-scroll { overscroll-behavior: contain; scrollbar-gutter: stable; }
+  .text-chat-messages { padding: 8px 18px 16px; gap: 18px; }
+  .text-chat-user { padding: 8px 12px; border-radius: 12px 12px 3px 12px; max-width: 88%; background: #edf1e7; }
+  .text-chat-user > .text-chat-status { display: none; }
+  .text-chat-answer { padding: 0; }
+  .text-chat-author { margin-bottom: 7px; font-size: 11px; }
+  .text-chat-message-actions { margin-top: 7px; gap: 3px; }
+  .text-chat-message-actions button { font-size: 11px; min-height: 26px; padding: 2px 6px; }
+  .text-chat-message-actions > span { margin-left: auto; font-size: 10px; }
+  .text-chat-empty { padding: 18px 20px; gap: 9px; }
+  .text-chat-emblem { width: 35px; height: 35px; }
+  .text-chat-empty h2 { font-size: 18px; }
+  .text-chat-empty p { margin: 0; font-size: 12px; }
+  .text-chat-starters { gap: 6px; margin-top: 6px; }
+  .text-chat-starters button { padding: 7px 10px; font-size: 12px; }
+  .text-chat-latest { bottom: 12px; }
+  .discussion-results { gap: 7px; margin: 10px 0 0; }
+  .discussion-result { display: grid; grid-template-columns: 72px minmax(0, 1fr) auto; align-items: center; gap: 10px; padding: 8px; border-radius: 12px; }
+  .discussion-result-media { width: 72px; max-height: 72px; overflow: hidden; border-radius: 7px; }
+  .discussion-result-media .workflow-bubble__media-item { min-height: 0; height: 64px; width: 72px; }
+  .discussion-result-media img { width: 72px; height: 64px; object-fit: cover; }
+  .discussion-result-media video { width: 72px; max-height: 72px; }
+  .discussion-result small { font-size: 11px; overflow-wrap: anywhere; color: var(--tc-soft); }
+  .discussion-result button { font-size: 11px; white-space: nowrap; }
+  .text-chat-history { padding: 10px; gap: 8px; }
+}
+@container canvas-composer (max-width: 440px) {
+  .text-chat-workspace--attached {
+    .attached-discussion-heading span { display: none; }
+    .text-chat-messages { padding: 8px 10px 12px; }
+    .text-chat-message-actions > span { display: none; }
+    .discussion-result { grid-template-columns: 56px minmax(0, 1fr); }
+    .discussion-result-media { width: 56px; grid-row: span 2; }
+    .discussion-result button { justify-self: start; }
+  }
+}
+[data-theme='dark'] .text-chat-workspace--attached,
+.dark .text-chat-workspace--attached {
+  --tc-paper: #222721; --tc-panel: #2b3028; --tc-surface: #2e332c;
+  --tc-ink: #e5e9e0; --tc-soft: #a5afa0; --tc-line: #3c4437;
+  --tc-selected: #35402e;
+  .text-chat-user { background: #35402e; }
+}
+
+.discussion-routing {
+  flex-shrink: 0; display: flex; align-items: center; flex-wrap: wrap; gap: 6px 18px;
+  padding: 7px 14px; border-bottom: 1px solid var(--text-chat-border, rgba(128,128,128,.16));
+  > div { display: flex; align-items: center; gap: 8px; min-width: 0; }
+  span { font-size: 11px; opacity: .6; white-space: nowrap; }
+  strong { font-size: 12px; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+  .discussion-routing__target { flex: 1 1 160px; }
+  .model-selector { max-width: 240px; }
+}
+.discussion-plan {
+  margin: 10px 0; padding: 12px; border: 1px solid rgba(128,128,128,.2); border-radius: 12px;
+  background: rgba(128,128,128,.04);
+  &__heading, &__actions, li > div { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
+  &__heading { font-size: 13px; span { opacity: .65; } }
+  ol { max-height: 210px; overflow-y: auto; padding-left: 22px; margin: 10px 0; overscroll-behavior: contain; }
+  li { padding: 6px 2px; font-size: 12px; }
+  li small { max-width: 55%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; opacity: .65; }
+  p { margin: 5px 0; white-space: pre-wrap; overflow-wrap: anywhere; }
+  > small { font-size: 11px; opacity: .65; }
+  &__actions { justify-content: flex-end; margin-top: 10px; button { padding: 6px 12px; border-radius: 8px; border: 1px solid rgba(128,128,128,.22); background: transparent; color: inherit; cursor: pointer; } }
+  button.discussion-plan__execute { background: #6457cf; color: #fff; border-color: transparent; }
+  button:disabled { opacity: .5; cursor: default; }
+}
+.discussion-result-text { max-height: 240px; overflow: auto; width: 100%; }
+.discussion-result-media audio { max-width: 100%; height: 34px; }
+.discussion-routing > .discussion-backend { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; flex: 1 1 100%; }
+.discussion-backend {
+  &__row { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; max-width: 100%; }
+  button, select { color: inherit; font: inherit; font-size: 12px; background: var(--text-chat-bg, transparent); border: 1px solid rgba(128,128,128,.22); border-radius: 7px; padding: 5px 8px; }
+  button { display: inline-flex; align-items: center; gap: 5px; cursor: pointer; }
+  select { max-width: 230px; min-width: 0; text-overflow: ellipsis; }
+  button:disabled, select:disabled { opacity: .5; cursor: default; }
+  > small { font-size: 10px; opacity: .65; }
+  &__error { font-size: 11px; color: var(--text-chat-error, #b34b45); overflow-wrap: anywhere; button { margin-left: 7px; } }
+}
+
+.text-chat-avatar { width: 28px; height: 28px; flex: 0 0 28px; object-fit: contain; border-radius: 9px; padding: 3px; background: #fff; border: 1px solid var(--tc-line); box-sizing: border-box; }
+.text-chat-author-model { font-size: 11px; color: var(--tc-soft); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
+.text-chat-author > strong { flex-shrink: 0; }
+
+.text-chat-canvas-context { display: block; margin-top: 8px; white-space: pre-wrap; font-size: 12px; line-height: 1.5; opacity: .8; overflow-wrap: anywhere; }
