+import type { WorkflowMessageData } from '../../types/chat.types';
+import { TaskStatus, TaskType, type Task } from '../../types/task.types';
+
+const workflow: WorkflowMessageData = {
+  id: 'wf',
+  name: 'Agent',
+  generationType: 'agent',
+  prompt: '',
+  count: 1,
+  steps: [
+    {
+      id: 'plan',
