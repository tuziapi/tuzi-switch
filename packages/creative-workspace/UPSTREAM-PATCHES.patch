+import React from "react";
+import {
+  cleanup,
+  fireEvent,
+  render,
+  screen,
+  waitFor,
+} from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { TextMarkdown } from "./TextMarkdown";
+afterEach(cleanup);
+describe("text message rendering", () => {
+  it("renders headings, tables and math without treating code as formulas", () => {
+    const view = render(
+      <TextMarkdown
+        content={
+          '## Plan\n\n| Task | Status |\n| --- | --- |\n| Build | Done |\n\n$E=mc^2$\n\n```js\nconst value = "$x$";\n```'
+        }
+      />,
+    );
+    expect(screen.getByRole("heading", { name: "Plan" })).toBeTruthy();
+    expect(view.container.querySelector("table")).toBeTruthy();
+    expect(view.container.querySelectorAll(".katex")).toHaveLength(1);
+    expect(view.container.querySelector("pre")?.textContent).toContain("$x$");
+  });
+  it("copies the original code without markup", async () => {
+    const write = vi.fn(async () => {});
+    Object.defineProperty(navigator, "clipboard", {
+      configurable: true,
+      value: { writeText: write },
+    });
+    render(
+      <TextMarkdown
+        content={'```typescript\nconst text = "<b>safe</b>";\n```'}
+      />,
+    );
+    fireEvent.click(screen.getByRole("button", { name: "复制代码" }));
+    await waitFor(() =>
+      expect(write).toHaveBeenCalledWith('const text = "<b>safe</b>";\n'),
+    );
+    expect(screen.getByRole("button", { name: "已复制" })).toBeTruthy();
+  });
+  it("does not execute raw HTML, javascript links or trusted math HTML commands", () => {
+    const view = render(
+      <TextMarkdown
+        content={
+          '<script>window.hacked=true</script>\n\n[bad](javascript:alert(1))\n\n$\\href{javascript:alert(1)}{bad}$\n\n```html\n<img onerror="alert(1)">\n```'
+        }
+      />,
+    );
+    expect(view.container.querySelector("script")).toBeNull();
+    expect(view.container.querySelector("[onerror]")).toBeNull();
+    expect(view.container.querySelector('a[href^="javascript:"]')).toBeNull();
+  });
+});
diff --git a/packages/drawnix/src/components/text-chat/TextMarkdown.tsx b/packages/drawnix/src/components/text-chat/TextMarkdown.tsx
new file mode 100644
index 0000000..f5fa252
--- /dev/null
+++ b/packages/drawnix/src/components/text-chat/TextMarkdown.tsx
@@ -0,0 +1,117 @@
+import React, { memo, useCallback } from "react";
+import katex from "katex";
+import "katex/dist/katex.min.css";
+import MarkdownReadonly from "../MarkdownReadonly";
+import copy from "copy-to-clipboard";
+
+export async function copyChatText(text: string): Promise<void> {
+  try {
+    await navigator.clipboard.writeText(text);
+  } catch {
+    if (!copy(text)) throw new Error("复制失败，请选择文字后复制。");
+  }
+}
+
+function CodeBlock({ code, language }: { code: string; language: string }) {
+  const [feedback, setFeedback] = React.useState("复制代码");
+  const copyCode = async () => {
+    try {
+      await copyChatText(code);
+      setFeedback("已复制");
+    } catch {
+      setFeedback("复制失败");
+    }
+  };
+  // Conservative highlighting; React text nodes always escape model-provided HTML.
+  const parts =
+    /^(js|javascript|ts|typescript|json|python|py|bash|sh|css|html)$/i.test(
+      language,
+    )
+      ? code.split(
+          /("(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*'|\b(?:const|let|return|function|async|await|import|from|export|if|else|class|def|for|in|True|False|None|true|false|null)\b)/g,
+        )
+      : [code];
+  return (
+    <div className="text-chat-code">
+      <div>
+        <span>{language || "text"}</span>
+        <button type="button" onClick={copyCode}>
+          {feedback}
+        </button>
+      </div>
+      <pre>
+        <code>
+          {parts.map((part, i) => (
+            <span
+              key={i}
+              className={
+                i % 2 ? (/^["']/.test(part) ? "string" : "keyword") : undefined
+              }
+            >
+              {part}
+            </span>
+          ))}
+        </code>
+      </pre>
+    </div>
+  );
+}
+
+function MathText({
+  value,
+  display = false,
+}: {
+  value: string;
+  display?: boolean;
+}) {
+  const html = React.useMemo(() => {
+    try {
+      return katex.renderToString(value, {
+        displayMode: display,
+        throwOnError: false,
+        trust: false,
+        strict: "ignore",
+        maxExpand: 500,
+        maxSize: 20,
+      });
+    } catch {
+      return null;
+    }
+  }, [value, display]);
+  return html ? (
+    <span
+      className="text-chat-math"
+      dangerouslySetInnerHTML={{ __html: html }}
+    />
+  ) : (
+    <code>{value}</code>
+  );
+}
+export const TextMarkdown = memo(function TextMarkdown({
+  content,
+}: {
+  content: string;
+}) {
+  const codeBlock = useCallback(
+    (code: string, language: string, key: string) =>
+      language === "math" || language === "latex" ? (
+        <MathText key={key} value={code} display />
+      ) : (
+        <CodeBlock key={key} code={code} language={language} />
+      ),
+    [],
+  );
+  const math = useCallback(
+    (value: string, display: boolean, key: string) => (
+      <MathText key={key} value={value} display={display} />
+    ),
+    [],
+  );
+  return (
+    <MarkdownReadonly
+      markdown={content}
+      renderCodeBlock={codeBlock}
+      renderMath={math}
+    />
+  );
+});
