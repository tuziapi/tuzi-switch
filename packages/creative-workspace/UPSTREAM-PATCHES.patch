@@ -0,0 +1,108 @@
+import React, { useSyncExternalStore } from "react";
+import { Plug, Unplug, Loader2 } from "lucide-react";
+import { localCodex } from "../../services/text-chat/local-codex";
+
+export function DiscussionBackend({
+  children,
+  busy,
+}: {
+  children: React.ReactNode;
+  busy: boolean;
+}) {
+  const state = useSyncExternalStore(
+    localCodex.subscribe,
+    localCodex.getSnapshot,
+  );
+  const model = state.models.find((m) => m.id === state.model);
+  const working = busy || state.running > 0;
+  return (
+    <div className="discussion-backend" data-testid="discussion-backend">
+      <div className="discussion-backend__row">
+        <span>{state.enabled ? "Codex 模型" : "讨论模型"}</span>
+        {state.enabled ? (
+          <>
+            <select
+              aria-label="Codex 文本模型"
+              value={state.model}
+              disabled={working || state.connecting}
+              onChange={(e) => localCodex.select(e.target.value)}
+            >
+              {state.models.map((m) => (
+                <option key={m.id} value={m.id}>
+                  {m.name}
+                </option>
+              ))}
+            </select>
+            {!!model?.efforts.length && (
+              <select
+                aria-label="Codex 思考强度"
+                value={state.effort || ""}
+                disabled={working || state.connecting}
+                onChange={(e) => localCodex.setEffort(e.target.value)}
+              >
+                {model.efforts.map((e) => (
+                  <option key={e} value={e}>
+                    {(
+                      {
+                        none: "无",
+                        minimal: "最少",
+                        low: "低",
+                        medium: "中",
+                        high: "高",
+                        xhigh: "更高",
+                        max: "最高",
+                        ultra: "极高",
+                      } as Record<string, string>
+                    )[e] || e}
+                  </option>
+                ))}
+              </select>
+            )}
+            <button
+              type="button"
+              title="断开后使用原来选择的文本模型"
+              disabled={working}
+              onClick={() => localCodex.disconnect()}
+            >
+              <Unplug size={13} />
+              断开
+            </button>
+          </>
+        ) : (
+          <>
+            {children}
+            <button
+              type="button"
+              disabled={working || state.connecting}
+              onClick={() => void localCodex.connect()}
+            >
+              {state.connecting ? (
+                <Loader2 className="text-chat-spin" size={13} />
+              ) : (
+                <Plug size={13} />
+              )}
+              {state.connecting ? "连接中…" : "连接本地 Codex"}
+            </button>
+          </>
+        )}
+      </div>
+      {state.enabled && !state.error && (
+        <small>本地 Codex 已启用 · 生成仍使用已选媒体模型</small>
+      )}
+      {state.error && (
+        <div className="discussion-backend__error" role="alert">
+          {state.error}
+          {state.enabled && (
+            <button
+              type="button"
+              disabled={working || state.connecting}
+              onClick={() => void localCodex.connect()}
+            >
+              重新连接
+            </button>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/packages/drawnix/src/components/text-chat/DiscussionResults.tsx b/packages/drawnix/src/components/text-chat/DiscussionResults.tsx
new file mode 100644
index 0000000..e408823
--- /dev/null
+++ b/packages/drawnix/src/components/text-chat/DiscussionResults.tsx
@@ -0,0 +1,268 @@
+import React, { useEffect, useState } from "react";
+import { LocateFixed, RotateCcw } from "lucide-react";
+import type { DiscussionLink } from "../../services/text-chat/conversation";
+import { taskQueueService } from "../../services/task-queue";
+import { TaskStatus } from "../../types/task.types";
+import { workspaceService } from "../../services/workspace-service";
+import { useDrawnix } from "../../hooks/use-drawnix";
+import { WorkflowResultImage } from "../chat-drawer/WorkflowResultImage";
+import { useMediaUrl } from "../../hooks/useMediaCache";
+import { textChatRuntime } from "../../services/text-chat/runtime";
+import { discussionTargetLabels } from "../../services/text-chat/discussion-plan";
+import { TextMarkdown, copyChatText } from "./TextMarkdown";
+import { scrollToPoint } from "../../utils/selection-utils";
+
+function DiscussionMedia({
+  taskId,
+  source,
+  audio,
+}: {
+  taskId: string;
+  source: string;
+  audio?: boolean;
+}) {
+  const { url, isLoading } = useMediaUrl(taskId, source);
+  if (audio)
+    return url ? (
+      <audio src={url} controls preload="none" aria-label="生成音频" />
+    ) : (
+      <span>
+        {isLoading ? "正在读取音频…" : "音频缓存不可用，请在任务列表查看。"}
+      </span>
+    );
+  return url ? (
+    <video src={url} controls preload="none" aria-label="生成视频" />
+  ) : (
+    <span>
+      {isLoading ? "正在读取视频…" : "视频缓存不可用，请在任务列表查看。"}
+    </span>
+  );
+}
+
+export function DiscussionResults({
+  link,
+  onLocate,
+  sessionId,
+  messageId,
+  busy,
+}: {
+  link: DiscussionLink;
+  onLocate?: () => void;
+  sessionId?: string;
+  messageId?: string;
+  busy?: boolean;
+}) {
+  const read = () =>
+    taskQueueService
+      .getAllTasks()
+      .filter(
+        (t) =>
+          t.params.conversationLink?.runId === link.runId &&
+          t.params.conversationLink?.boardId === link.boardId,
+      );
+  const [tasks, setTasks] = useState(read);
+  const [notice, setNotice] = useState("");
+  const { board } = useDrawnix();
+  useEffect(() => {
+    setTasks(read());
+    const sub = taskQueueService.observeTaskUpdates().subscribe(({ task }) => {
+      if (task.params.conversationLink?.runId === link.runId) setTasks(read());
+    });
+    return () => sub.unsubscribe();
+  }, [link.runId]);
+  const action = (taskId: string, locate: boolean) => {
+    if (workspaceService.getState().currentBoardId !== link.boardId) {
+      setNotice("请先返回这段讨论所属的画板，再定位或同步结果。");
+      return;
+    }
+    if (!locate) {
+      window.dispatchEvent(
+        new CustomEvent("aitu:discussion-sync", { detail: { taskId } }),
+      );
+      setNotice("正在同步已有结果，不会重新生成。");
+      return;
+    }
+    const task = tasks.find((t) => t.id === taskId);
+    const urls = task?.result?.urls || [task?.result?.url];
+    const element = board?.children.find(
+      (e) => e.generationTaskId === taskId || urls.includes(e.url as string),
+    );
+    if (element?.points?.[0]) {
+      onLocate?.();
+      requestAnimationFrame(() => {
+        if (workspaceService.getState().currentBoardId === link.boardId)
+          scrollToPoint(board!, element.points[0]);
+      });
+    } else setNotice("画布中未找到该作品，可能已被删除。聊天记录仍保留。");
+  };
+  const decide = async (execute: boolean) => {
+    if (!sessionId || !messageId) return;
+    if (
+      execute &&
+      workspaceService.getState().currentBoardId !== link.boardId
+    ) {
+      setNotice("请先返回这段讨论所属的画板再执行。");
+      return;
+    }
+    try {
+      await textChatRuntime.decidePlan(sessionId, messageId, execute);
+    } catch (e) {
+      setNotice((e as Error).message);
+    }
+  };
+  if (!tasks.length && !link.plan) return null;
+  return (
+    <section className="discussion-results" aria-label="讨论生成任务">
+      {link.plan && (
+        <div className="discussion-plan" data-testid="discussion-plan">
+          <div className="discussion-plan__heading">
+            <strong>
+              {link.plan.status === "ready"
+                ? "待确认的生成计划"
+                : link.plan.status === "cancelled"
+                  ? "计划已取消"
+                  : "已提交的生成计划"}
+            </strong>
+            <span>
+              {link.plan.steps.reduce((n, s) => n + s.count, 0)} 个任务
+            </span>
+          </div>
+          <ol>
+            {link.plan.steps.map((step, i) => (
+              <li key={i}>
+                <div>
+                  <strong>
+                    {discussionTargetLabels[step.type]} {i + 1}
+                    {step.count > 1 ? ` · 同一提示词 × ${step.count}` : ""}
+                  </strong>
+                  <small title={step.model}>{step.model}</small>
+                </div>
+                <p>{step.prompt}</p>
+              </li>
+            ))}
+          </ol>
+          {link.plan.status === "ready" && (
+            <>
+              <small>
+                {link.plan.steps.some((step) => step.type === "image")
+                  ? "每条图片提示词描述一张作品；同一提示词的多张变体分别生成。"
+                  : "使用计划中的模型执行。"}
+                调整底部模型后，请重新讨论生成计划。
+              </small>
+              <div className="discussion-plan__actions">
+                <button
+                  type="button"
+                  disabled={busy}
+                  onClick={() => void decide(false)}
+                >
+                  取消计划
+                </button>
+                <button
+                  type="button"
+                  className="discussion-plan__execute"
+                  disabled={busy}
+                  onClick={() => void decide(true)}
+                >
+                  执行 {link.plan.steps.reduce((n, s) => n + s.count, 0)} 个任务
+                </button>
+              </div>
+            </>
+          )}
+        </div>
+      )}
+      {tasks.length > 0 && (
+        <div className="text-chat-status">
+          生成任务 ·{" "}
+          {tasks.filter((t) => t.status === TaskStatus.COMPLETED).length}/
+          {tasks.length} 完成
+        </div>
+      )}
+      {tasks.map((task) => (
+        <div className="discussion-result" key={task.id} data-task-id={task.id}>
+          <div className="discussion-result-media">
+            {(task.result?.urls?.length
+              ? task.result.urls
+              : task.result?.url
+                ? [task.result.url]
+                : []
+            ).map((url, i) =>
+              task.type === "video" || task.type === "audio" ? (
+                <DiscussionMedia
+                  key={url}
+                  taskId={task.id}
+                  source={url}
+                  audio={task.type === "audio"}
+                />
+              ) : (
+                <WorkflowResultImage
+                  key={url}
+                  url={url}
+                  thumbnailUrl={task.result?.thumbnailUrls?.[i]}
+                  index={i}
+                  onPreview={() => action(task.id, true)}
+                />
+              ),
+            )}
+          </div>
+          {(task.result?.chatResponse || task.result?.lyricsText) && (
+            <div className="discussion-result-text">
+              <TextMarkdown
+                content={
+                  task.result.chatResponse || task.result.lyricsText || ""
+                }
+              />
+              <button
+                type="button"
+                onClick={() =>
+                  void copyChatText(
+                    task.result?.chatResponse || task.result?.lyricsText || "",
+                  )
+                    .then(() => setNotice("已复制文本"))
+                    .catch((e) => setNotice(e.message))
+                }
+              >
+                复制文本
+              </button>
+            </div>
+          )}
+          <small>
+            {task.params.model} ·{" "}
+            {task.status === TaskStatus.COMPLETED
+              ? task.insertedToCanvas
+                ? "已放入画布"
+                : task.type === "chat"
+                  ? "已生成 · 保留在讨论中"
+                  : "已生成 · 等待画布同步"
+              : task.status === TaskStatus.FAILED
+                ? "生成失败，请在任务列表查看详情"
+                : task.status === TaskStatus.CANCELLED
+                  ? "已停止"
+                  : "生成中"}
+          </small>
+          {task.status === TaskStatus.COMPLETED && (
+            <button
+              type="button"
+              onClick={() => action(task.id, Boolean(task.insertedToCanvas))}
+            >
+              {task.insertedToCanvas ? (
+                <LocateFixed size={13} />
+              ) : (
+                <RotateCcw size={13} />
+              )}
+              {task.insertedToCanvas
+                ? "定位画布"
+                : task.type === "chat"
+                  ? "放入画布"
+                  : "同步到画布"}
+            </button>
+          )}
+        </div>
+      ))}
+      {notice && (
+        <div className="text-chat-status" role="status">
+          {notice}
+        </div>
+      )}
+    </section>
+  );
+}
diff --git a/packages/drawnix/src/components/text-chat/TextAttachments.tsx b/packages/drawnix/src/components/text-chat/TextAttachments.tsx
new file mode 100644
index 0000000..9c7e372
--- /dev/null
+++ b/packages/drawnix/src/components/text-chat/TextAttachments.tsx
@@ -0,0 +1,174 @@
+import { memo, useEffect, useRef, useState } from "react";
+import { createPortal } from "react-dom";
+import { FileText, Image as ImageIcon, X } from "lucide-react";
+import {
+  readTextAttachment,
+  type TextAttachmentRef,
+  type TextAttachmentRecord,
+} from "../../services/text-chat/attachments";
+
+const AttachmentCard = memo(function AttachmentCard({
+  attachment,
+  remove,
+}: {
+  attachment: TextAttachmentRef;
+  remove?: (id: string) => void;
+}) {
+  const [record, setRecord] = useState<TextAttachmentRecord | null>(null);
+  const [error, setError] = useState("");
+  const [open, setOpen] = useState(false);
+  const preview = useRef<HTMLDivElement>(null);
+  const trigger = useRef<HTMLButtonElement>(null);
+  useEffect(() => {
+    if (attachment.kind !== "image" && !open) return;
+    let active = true;
+    void readTextAttachment(attachment)
+      .then((r) => {
+        if (active)
+          setRecord(
+            !open && r.thumbnailDataUrl ? { ...r, dataUrl: undefined } : r,
+          );
+      })
+      .catch((e) => {
+        if (active) setError(e.message);
+      });
+    return () => {
+      active = false;
+    };
+  }, [attachment.id, attachment.kind, open]);
+  useEffect(() => {
+    if (open) preview.current?.focus();
+  }, [open]);
+  const close = () => {
+    setOpen(false);
+    trigger.current?.focus();
+  };
+  return (
+    <>
+      <div className="text-chat-attachment" data-attachment-id={attachment.id}>
+        <button
+          ref={trigger}
+          type="button"
+          className="text-chat-attachment-open"
+          aria-label={`预览附件 ${attachment.name}`}
+          onClick={() => setOpen(true)}
+        >
+          {attachment.kind === "image" ? (
+            record?.thumbnailDataUrl || record?.dataUrl ? (
+              <img
+                src={record.thumbnailDataUrl || record.dataUrl}
+                alt=""
+                loading="lazy"
+              />
+            ) : (
+              <ImageIcon />
+            )
+          ) : (
+            <FileText />
+          )}
+          <span>
+            <strong>{attachment.name}</strong>
+            <small>
+              {attachment.kind === "image"
+                ? "图片"
+                : attachment.pages
+                  ? `PDF · ${attachment.pages} 页 · 提取文字`
+                  : "文本文件"}{" "}
+              · {Math.max(1, Math.round(attachment.size / 1024))} KB
+            </small>
+          </span>
+        </button>
+        {remove && (
+          <button
+            type="button"
+            className="text-chat-attachment-remove"
+            aria-label={`移除附件 ${attachment.name}`}
+            onClick={() => remove(attachment.id)}
+          >
+            <X size={14} />
+          </button>
+        )}
+        {(error || attachment.warning) && (
+          <span className="text-chat-attachment-warning" role="status">
+            {error || attachment.warning}
+          </span>
+        )}
+      </div>
+      {open &&
+        createPortal(
+          <div
+            className="text-chat-attachment-backdrop"
+            onPointerDown={(e) => {
+              e.stopPropagation();
+              if (e.target === e.currentTarget) close();
+            }}
+            onWheel={(e) => e.stopPropagation()}
+          >
+            <div
+              ref={preview}
+              tabIndex={-1}
+              role="dialog"
+              aria-modal="true"
+              aria-label={`附件预览 ${attachment.name}`}
+              className="text-chat-attachment-preview"
+              onKeyDownCapture={(e) => {
+                e.stopPropagation();
+                if (e.key === "Escape") {
+                  e.preventDefault();
+                  close();
+                }
+                if (e.key === "Tab") {
+                  e.preventDefault();
+                  preview.current
+                    ?.querySelector<HTMLButtonElement>("button")
+                    ?.focus();
+                }
+              }}
+            >
+              <header>
+                <strong>{attachment.name}</strong>
+                <button type="button" aria-label="关闭附件预览" onClick={close}>
+                  <X />
+                </button>
+              </header>
+              {error ? (
+                <p role="alert">{error}</p>
+              ) : !record ? (
+                <p>正在读取附件…</p>
+              ) : attachment.kind === "image" ? (
+                <img src={record.dataUrl} alt={attachment.name} />
+              ) : (
+                <>
+                  <small>
+                    发送给模型的提取文字
+                    {attachment.pages
+                      ? "（不包含 PDF 图片、图表及原始版式）"
+                      : ""}
+                  </small>
+                  <pre>{record.text}</pre>
+                </>
+              )}
+              {attachment.warning && <p>{attachment.warning}</p>}
+            </div>
+          </div>,
+          trigger.current?.closest(".creative-root") || document.body,
+        )}
+    </>
+  );
+});
+export function TextAttachments({
+  attachments,
+  onRemove,
+}: {
+  attachments?: TextAttachmentRef[];
+  onRemove?: (id: string) => void;
+}) {
+  if (!attachments?.length) return null;
+  return (
+    <div className="text-chat-attachments">
+      {attachments.map((a) => (
