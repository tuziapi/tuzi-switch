+  .text-chat-message-actions > span { margin-left: auto; font-size: 10px; }
+  .text-chat-empty { padding: 18px 20px; gap: 9px; }
+  .text-chat-emblem { width: 35px; height: 35px; }
+  .text-chat-empty h2 { font-size: 18px; }
+  .text-chat-empty p { margin: 0; font-size: 12px; }
+  .text-chat-starters { gap: 6px; margin-top: 6px; }
+  .text-chat-starters button { padding: 7px 10px; font-size: 12px; }
+  .text-chat-latest { bottom: 12px; }
+  .discussion-results { gap: 7px; margin: 10px 0 0; }
+  .discussion-result { display: grid; grid-template-columns: 72px minmax(0, 1fr) auto; align-items: center; gap: 10px; padding: 8px; border-radius: 12px; }
+  .discussion-result-media { width: 72px; max-height: 72px; overflow: hidden; border-radius: 7px; }
+  .discussion-result-media .workflow-bubble__media-item { min-height: 0; height: 64px; width: 72px; }
+  .discussion-result-media img { width: 72px; height: 64px; object-fit: cover; }
+  .discussion-result-media video { width: 72px; max-height: 72px; }
+  .discussion-result small { font-size: 11px; overflow-wrap: anywhere; color: var(--tc-soft); }
+  .discussion-result button { font-size: 11px; white-space: nowrap; }
+  .text-chat-history { padding: 10px; gap: 8px; }
+}
+@container canvas-composer (max-width: 440px) {
+  .text-chat-workspace--attached {
