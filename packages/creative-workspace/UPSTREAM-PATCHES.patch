+    &::-webkit-scrollbar { display: none; }
+  }
+  .ai-input-composer-shell__bottom-start { grid-column: 1; grid-row: 2; }
+  .ai-input-composer-shell__bottom-bar > .ai-input-bar__send-btn { grid-column: 2; grid-row: 2; }
+}
+
+// Shared composer: the transcript opens above it, without a canvas-wide overlay.
+.ai-input-composer-shell--discussion {
+  .attached-discussion { position: relative; margin: 0 -10px 5px; flex-shrink: 0; }
+  &.ai-input-composer-shell--expanded .attached-discussion { margin: 0 -12px 5px; }
+  .attached-discussion .discussion-strip { margin: 0; padding: 0 12px; }
+  &:has(.attached-discussion.is-open) { border-top-left-radius: 0; border-top-right-radius: 0; transition: none; }
+  .attached-discussion.is-open .discussion-strip { border-radius: 0; }
+}
+.attached-discussion {
+  pointer-events: auto;
+  &__panel {
+    position: absolute; bottom: 100%; left: 0; width: 100%;
+    display: flex; flex-direction: column; overflow: hidden;
+    border: 1px solid var(--color-border, #e3e5df); border-bottom: 0;
+    border-radius: 18px 18px 0 0;
+    background: var(--island-bg-color, #fffefa);
+    box-sizing: border-box;
+    box-shadow: 0 -10px 32px #2833250d;
+    user-select: text; -webkit-user-select: text;
+    overscroll-behavior: contain;
+  }
+  &__loading { padding: 24px; font-size: 13px; color: var(--text-color, #555); }
+  button:focus-visible { outline: 2px solid #638059; outline-offset: -2px; }
+}
+.ai-input-composer-slot,
+.ai-input-composer-mount {
+  display: flex;
+  flex-direction: column;
+  width: 100%;
+  min-height: 0;
+  pointer-events: auto;
+}
+.ai-input-composer-slot { max-height: 100%; }
+.ai-input-composer-mount { flex: 1; max-height: 100%; }
+.attached-discussion .text-chat-header svg { pointer-events: none; }
+.Dialog-overlay:has(.attached-discussion-modal) {
+  grid-template-columns: minmax(0, 1fr);
+  grid-template-rows: minmax(0, 1fr);
+  overflow: hidden;
+}
+.ai-input-bar.attached-discussion-modal {
+  position: relative;
+  inset: auto;
+  transform: none;
+  z-index: auto;
+  width: min(1000px, calc(100% - 48px));
+  height: min(820px, calc(100% - 48px));
+  max-width: none;
+  padding: 0;
+  gap: 0;
+  border: 1px solid var(--color-border, #e3e5df);
+  border-radius: 20px;
+  background: var(--island-bg-color, #fff);
+  box-shadow: 0 24px 80px #0003;
+  pointer-events: auto;
+  .attached-discussion-modal__panel {
+    display: flex; flex: 1; flex-direction: column; min-height: 0; width: 100%;
+  }
+  .ai-input-composer-shell--canvas {
+    flex: 1;
+    border-radius: 20px;
+    box-shadow: none;
+    overflow: hidden;
+    padding: 0 20px 16px;
+    transition: none;
+    background: var(--island-bg-color, #fff);
+  }
+  .ai-input-composer-shell__input-area {
+    flex-shrink: 0;
+    max-height: 32%;
+    border: 1px solid var(--color-border, #e3e5df);
+    border-radius: 14px;
+    margin-top: 12px;
+    margin-bottom: 10px;
+  }
+  .attached-discussion {
+    flex: 1; min-height: 0; margin: 0 -20px;
+    display: flex; flex-direction: column;
+  }
+  .attached-discussion__panel {
+    position: relative; inset: auto; flex: 1; min-height: 0;
+    border: 0; border-bottom: 1px solid var(--color-border, #e3e5df);
+    border-radius: 20px 20px 0 0; box-shadow: none;
+  }
+  .discussion-strip { display: none; }
+  .text-chat-header { padding: 16px 20px; }
+  .text-chat-workspace { font-size: 14px; }
+  .text-chat-messages {
+    width: 100%;
+    max-width: none;
+    margin: 0;
+    box-sizing: border-box;
+    padding: 20px 24px 28px;
+    &--virtual { padding-block: 0; }
+  }
+  .text-chat-virtual-row { left: 24px; right: 24px; }
+}
+:root[data-theme='dark'] .ai-input-bar.attached-discussion-modal,
+.creative-root[data-theme='dark'] .ai-input-bar.attached-discussion-modal {
+  background: var(--color-surface-high, #2a2a2a);
+  .ai-input-composer-shell--canvas { background: var(--color-surface-high, #2a2a2a); }
+}
+@media (max-width: 760px), (max-height: 600px) {
+  .ai-input-bar.attached-discussion-modal {
+    width: calc(100% - 24px);
+    height: calc(100% - 24px);
+    border-radius: 14px;
+    .ai-input-composer-shell--canvas { border-radius: 14px; padding: 0 12px 10px; }
+    .attached-discussion { margin: 0 -12px; }
+    .attached-discussion__panel { border-radius: 14px 14px 0 0; }
+    .text-chat-header { padding: 10px 12px; }
+    .text-chat-messages { padding: 12px 18px 18px; }
+    .text-chat-messages--virtual { padding-block: 0; }
+    .text-chat-virtual-row { left: 18px; right: 18px; }
+    .discussion-routing { padding-top: 4px; padding-bottom: 4px; }
+  }
+}
+
+.ai-input-bar__generation-roles {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  padding: 4px 12px 8px;
+  font-size: 12px;
+  label { display: flex; align-items: center; gap: 6px; }
+  select { padding: 4px; border: 1px solid #d8d2ea; border-radius: 6px; background: transparent; color: inherit; }
+}
+
+
+// The draft editor follows its selected card without animated lag while dragging.
+.ai-input-bar.ai-input-bar--generation-editor {
+  padding: 0;
+  max-width: 440px;
+  transition: none;
+  .ai-input-composer-shell--canvas {
+    border: 1px solid #dcd5ef;
+    border-radius: 16px;
+    box-shadow: 0 8px 30px rgba(45, 36, 75, .10);
+  }
+  .ai-input-bar__restore-status {
+    margin-bottom: 8px;
+    color: #777080;
+    font-size: 12px;
+    button {
+      display: flex;
+      padding: 4px;
+      border-radius: 6px;
+      &:hover { background: #f0ecfa; }
+    }
+  }
+  .ai-input-bar__input { font-size: 14px; }
+}
+
+.ai-input-bar.ai-input-bar--generation-editor {
+  .ai-input-composer-shell--canvas { transition: none; }
+  .ai-input-composer-shell__input-area--expanded { max-height: 300px; transition: none; }
+  .ai-input-composer-shell__bottom-bar {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr) auto;
+    row-gap: 6px;
+  }
+  .ai-input-composer-shell__bottom-start { grid-column: 1 / -1; }
+  .ai-input-composer-shell__bottom-controls {
+    justify-content: flex-start;
+    flex-wrap: wrap;
+    overflow: visible;
+    gap: 4px;
+  }
+}
