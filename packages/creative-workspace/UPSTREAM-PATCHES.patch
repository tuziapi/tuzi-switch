+import React from "react";
+import { act, cleanup, render, fireEvent } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { NativeMediaOverlay } from "./native-media-overlay";
+vi.mock("../../utils/tauri-env", () => ({
+  isNativeRenderEnvironment: () => true,
+}));
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+  document.body.innerHTML = "";
+});
+describe("native media overlay", () => {
+  it("keeps interactive media outside foreignObject, follows geometry and releases its layer", async () => {
+    vi.stubGlobal("PointerEvent", class extends MouseEvent { pointerId: number; constructor(type: string, init: PointerEventInit = {}) { super(type, init); this.pointerId = init.pointerId ?? 7; } });
+    vi.stubGlobal(
+      "ResizeObserver",
+      class {
+        observe() {}
+        disconnect() {}
+      },
+    );
+    let scheduled: FrameRequestCallback | undefined;
+    vi.stubGlobal("requestAnimationFrame", (f: FrameRequestCallback) => {
+      scheduled = f;
+      return 1;
+    });
+    vi.stubGlobal("cancelAnimationFrame", vi.fn());
+    const board = document.createElement("div");
+    board.className = "plait-board-container";
+    document.body.append(board);
+    board.getBoundingClientRect = () => ({ left: 10, top: 20 }) as DOMRect;
+    const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
+    board.append(svg);
+    const fo = document.createElementNS(
+      svg.namespaceURI,
+      "foreignObject",
+    ) as SVGForeignObjectElement;
+    svg.append(fo);
+    for (const [name, value] of Object.entries({
+      x: 30,
+      y: 40,
+      width: 200,
+      height: 100,
+    }))
+      Object.defineProperty(fo, name, {
+        value: { baseVal: { value } },
+        configurable: true,
+      });
+    fo.getScreenCTM = () =>
+      ({ a: 2, b: 0, c: 0, d: 2, e: 10, f: 20 }) as DOMMatrix;
+    const target = document.createElement("div");
+    fo.append(target);
+    const click = vi.fn();
+    const view = render(
+      <NativeMediaOverlay>
+        <><button onClick={click}>Play</button><div data-canvas-media-drag="true">Drag</div></>
+      </NativeMediaOverlay>,
+      { container: target },
+    );
+    const layer = board.querySelector<HTMLElement>(
+      "[data-native-media-overlay]",
+    )!;
+    expect(layer.style.transform).toBe("matrix(2,0,0,2,60,80)");
+    expect(fo.querySelector("button")).toBeNull();
+    layer.querySelector("button")!.click();
+    expect(click).toHaveBeenCalledOnce();
+    const down = vi.fn();
+    svg.addEventListener('pointerdown', down);
+    fireEvent.pointerDown(layer.querySelector('button')!);
+    expect(down).not.toHaveBeenCalled();
+    fireEvent.pointerDown(layer.querySelector('[data-canvas-media-drag]')!, { clientX: 120, clientY: 80, buttons: 1, pointerId: 7 });
+    expect(down).toHaveBeenCalledOnce();
+    const move = vi.fn(); const up = vi.fn();
+    svg.addEventListener('pointermove', move); svg.addEventListener('pointerup', up);
+    fireEvent.pointerMove(layer.querySelector('[data-canvas-media-drag]')!, { clientX: 150, clientY: 90, buttons: 1 });
+    fireEvent.pointerUp(layer.querySelector('[data-canvas-media-drag]')!, { clientX: 150, clientY: 90 });
+    expect(move).toHaveBeenCalledOnce(); expect(up).toHaveBeenCalledOnce();
+    fo.x.baseVal.value = 50;
+    fo.setAttribute("x", "50");
+    await act(async () => {});
+    act(() => scheduled?.(0));
+    expect(layer.style.transform).toBe("matrix(2,0,0,2,100,80)");
+    view.unmount();
+    expect(board.querySelector("[data-native-media-overlay]")).toBeNull();
+  });
+});
diff --git a/packages/drawnix/src/plugins/components/native-media-overlay.tsx b/packages/drawnix/src/plugins/components/native-media-overlay.tsx
new file mode 100644
index 0000000..c4cafad
--- /dev/null
+++ b/packages/drawnix/src/plugins/components/native-media-overlay.tsx
@@ -0,0 +1,95 @@
+import React, { useLayoutEffect, useRef, useState } from "react";
+import { createPortal } from "react-dom";
+import { isNativeRenderEnvironment } from "../../utils/tauri-env";
+
+/** WebKit does not reliably composite HTML media inside SVG foreignObject. */
+export function NativeMediaOverlay({
+  children,
+}: {
+  children: React.ReactNode;
+}) {
+  const anchor = useRef<HTMLDivElement>(null);
+  const [host, setHost] = useState<HTMLDivElement | null>(null);
+  useLayoutEffect(() => {
+    if (!isNativeRenderEnvironment()) return;
+    const foreignObject = anchor.current?.closest("foreignObject");
+    const board = foreignObject?.closest<HTMLElement>(".plait-board-container");
+    const svg = foreignObject?.ownerSVGElement;
+    if (!foreignObject || !board || !svg) return;
+    const layer = document.createElement("div");
+    layer.dataset.nativeMediaOverlay = "true";
+    layer.style.cssText =
+      "position:absolute;left:0;top:0;transform-origin:0 0;pointer-events:auto;";
+    board.appendChild(layer);
+    // The HTML media layer is a sibling of the SVG host. Forward only the
+    // dedicated drag surface; playback controls keep their native events.
+    let draggingPointer: number | undefined;
+    const forwardDrag = (event: PointerEvent) => {
+      if (event.type === 'pointerdown') {
+        if (!(event.target instanceof Element) || !event.target.closest('[data-canvas-media-drag]')) return;
+        draggingPointer = event.pointerId;
+      } else if (draggingPointer === undefined || draggingPointer !== event.pointerId) return;
+      event.preventDefault();
+      event.stopPropagation();
+      foreignObject.dispatchEvent(new PointerEvent(event.type, {
+        bubbles: true, cancelable: true, composed: true,
+        pointerId: event.pointerId, pointerType: event.pointerType, isPrimary: event.isPrimary,
+        clientX: event.clientX, clientY: event.clientY, button: event.button, buttons: event.buttons,
+        ctrlKey: event.ctrlKey, shiftKey: event.shiftKey, altKey: event.altKey, metaKey: event.metaKey,
+        pressure: event.pressure,
+      }));
+    };
+    const endDrag = () => { draggingPointer = undefined; };
+    for (const type of ['pointerdown', 'pointermove', 'pointerup']) layer.addEventListener(type, forwardDrag as EventListener);
+    window.addEventListener('pointerup', endDrag);
+    window.addEventListener('pointercancel', endDrag);
+    let frame = 0;
+    const sync = () => {
+      frame = 0;
+      const matrix = foreignObject.getScreenCTM();
+      const rect = board.getBoundingClientRect();
+      if (!matrix || !foreignObject.isConnected) {
+        layer.style.display = "none";
+        return;
+      }
+      const x = foreignObject.x.baseVal.value;
+      const y = foreignObject.y.baseVal.value;
+      layer.style.display =
+        getComputedStyle(foreignObject).visibility === "hidden" ? "none" : "";
+      layer.style.width = `${foreignObject.width.baseVal.value}px`;
+      layer.style.height = `${foreignObject.height.baseVal.value}px`;
+      layer.style.transform = `matrix(${matrix.a},${matrix.b},${matrix.c},${matrix.d},${matrix.e + matrix.a * x + matrix.c * y - rect.left - board.clientLeft + board.scrollLeft},${matrix.f + matrix.b * x + matrix.d * y - rect.top - board.clientTop + board.scrollTop})`;
+    };
+    const schedule = () => {
+      if (!frame) frame = requestAnimationFrame(sync);
+    };
+    const observer = new MutationObserver(schedule);
+    observer.observe(svg, { attributes: true, subtree: true, childList: true });
+    const resize = new ResizeObserver(schedule);
+    resize.observe(board);
+    window.addEventListener("scroll", schedule, true);
+    window.addEventListener("resize", schedule);
+    sync();
+    setHost(layer);
+    return () => {
+      for (const type of ['pointerdown', 'pointermove', 'pointerup']) layer.removeEventListener(type, forwardDrag as EventListener);
+      window.removeEventListener('pointerup', endDrag);
+      window.removeEventListener('pointercancel', endDrag);
+      observer.disconnect();
+      resize.disconnect();
+      cancelAnimationFrame(frame);
+      window.removeEventListener("scroll", schedule, true);
+      window.removeEventListener("resize", schedule);
+      layer.remove();
+    };
+  }, []);
+  return (
+    <div
+      ref={anchor}
+      data-native-media-anchor="true"
+      style={{ width: "100%", height: "100%" }}
+    >
+      {host ? createPortal(children, host) : children}
+    </div>
+  );
+}
