+.ai-input-composer-slot,
+.ai-input-composer-mount {
+  display: flex;
+  flex-direction: column;
+  width: 100%;
+  min-height: 0;
+  pointer-events: auto;
+}
+.ai-input-composer-slot { max-height: 100%; }
+.ai-input-composer-mount { flex: 1; max-height: 100%; }
+.attached-discussion .text-chat-header svg { pointer-events: none; }
+.Dialog-overlay:has(.attached-discussion-modal) {
+  grid-template-columns: minmax(0, 1fr);
+  grid-template-rows: minmax(0, 1fr);
+  overflow: hidden;
+}
+.ai-input-bar.attached-discussion-modal {
+  position: relative;
+  inset: auto;
+  transform: none;
+  z-index: auto;
+  width: min(1000px, calc(100% - 48px));
+  height: min(820px, calc(100% - 48px));
+  max-width: none;
+  padding: 0;
+  gap: 0;
+  border: 1px solid var(--color-border, #e3e5df);
+  border-radius: 20px;
+  background: var(--island-bg-color, #fff);
