+  });
+
+  it('does not borrow planner IDs or expose local IDs as provider task IDs', () => {
+    const planner = {
+      id: 'plan-task',
+      type: TaskType.CHAT,
+      status: TaskStatus.FAILED,
+      params: { model: 'planner', workflowId: 'wf' },
+      remoteId: 'wrong-remote',
+      error: {
