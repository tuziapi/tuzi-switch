+vi.mock("../../utils/gemini-api/message-utils", () => ({
+  normalizeImageUrlForMultimodalInput: async (url: string) => url,
+}));
+import { localCodex, requestCodexDiscussion } from "./local-codex";
+const models = [
+  {
+    id: "synthetic-codex",
+    name: "Synthetic",
+    efforts: ["low", "high"],
+    defaultEffort: "high",
+    supportsImages: true,
