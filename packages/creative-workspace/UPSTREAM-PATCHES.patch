+    setAutoCompleteState(board, {
+      visible: true,
+      position: { x: event.clientX - 140, y: event.clientY + 20 },
+      sourceElement: source || null,
+      currentShape: BasicShapes.rectangle,
+      hitIndex: -1, hitPoint: null, mode: 'arrowLine',
