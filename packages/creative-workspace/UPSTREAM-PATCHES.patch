+        defaultValue: 'auto',
+        options: [
+          { value: 'auto', label: '自动（原始尺寸）' },
+          { value: '1024x1024', label: '1:1 方形' },
+          { value: '1024x1536', label: '2:3 竖版' },
+          { value: '1536x1024', label: '3:2 横版' },
